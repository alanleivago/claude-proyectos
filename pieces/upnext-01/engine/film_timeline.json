 "cards": [
  {
   "text": "From tomorrow on, I'm waking at four.",
   "spk": "G",
   "start": 0.4,
   "typed": 2.302,
   "end": 3.12,
   "v0": 0.5,
   "v1": 2.62
  },
  {
   "text": "Four. Now.",
   "spk": "P",
   "start": 3.9,
   "typed": 5.164,
   "end": 5.8,
   "v0": 4.0,
   "v1": 5.37
  },
  {
   "text": "…Is this counting?",
   "spk": "G",
   "start": 5.8,
   "typed": 6.657,
   "end": 7.29,
   "v0": 5.9,
   "v1": 6.79
  },
  {
   "text": "Nope.",
   "spk": "P",
   "start": 7.6,
   "typed": 8.202,
   "end": 8.79,
   "v0": 7.7,
   "v1": 8.29
  },
  {
   "text": "…Tomorrow, then.",
   "spk": "G",
   "start": 10.6,
   "typed": 11.796,
   "end": 12.49,
   "v0": 10.7,
   "v1": 11.99
  },
  {
   "text": "Some guy jogged six miles before dawn.",
   "spk": "G",
   "start": 13.8,
   "typed": 15.719,
   "end": 16.54,
   "v0": 13.9,
   "v1": 16.04
  },
  {
   "text": "I guess…",
   "spk": "G",
   "start": 18.9,
   "typed": 19.366,
   "end": 19.93,
   "v0": 19.0,
   "v1": 19.43
  },
  {
   "text": "I'm just not hungry enough.",
   "spk": "G",
   "start": 20.445,
   "typed": 21.48,
   "end": 22.145,
   "v0": 20.545,
   "v1": 21.645
  },
  {
   "text": "Time to cheat.",
   "spk": "P",
   "start": 22.9,
   "typed": 24.275,
   "end": 25.0,
   "v0": 23.0,
   "v1": 24.5
  },
  {
   "text": "…Need help, Pip?",
   "spk": "G",
   "start": 26.5,
   "typed": 27.204,
   "end": 27.81,
   "v0": 26.6,
   "v1": 27.31
  },
  {
   "text": "Nah.",
   "spk": "P",
   "start": 28.6,
   "typed": 29.329,
   "end": 29.94,
   "v0": 28.7,
   "v1": 29.44
  },
  {
   "text": "Tomorrow…",
   "spk": "P",
   "start": 31.8,
   "typed": 32.716,
   "end": 33.36,
   "v0": 31.9,
   "v1": 32.86
  },
  {
   "text": "your feet land on this first.",
   "spk": "P",
   "start": 34.17,
   "typed": 35.902,
   "end": 36.69,
   "v0": 34.27,
   "v1": 36.19
  },
  {
   "text": "And that bunks over there.",
   "spk": "P",
   "start": 36.9,
   "typed": 38.776,
   "end": 39.59,
   "v0": 37.0,
   "v1": 39.09
  },
  {
   "text": "That's the trick?",
