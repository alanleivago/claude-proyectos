{
 "i01": [],
 "c01": ["Su baúl afuera antes de las ocho.", "Esta casa no es pensión."],
 "c02": ["Soy el papá de tu marido.", "Nomás pido unos días."],
 "c03": ["Hubiera avisado, don Hilario.", "No llegar así con su baúl."],
 "c04": ["Le marqué a Raymundo desde temprano.", "Nunca me contestó."],
 "c05": ["Estaba en la obra, papá.", "¿Qué te pasó?"],
 "c06": ["Tuve un problema, hijo.", "Déjame quedarme mientras lo arreglo."],
 "c07": ["No se puede, de veras.", "Tenemos la casa ocupada."],
 "c08": ["Duermo en el cuarto de la azotea.", "Yo mismo lo barro."],
 "c09": ["Ahí se queda mi mamá.", "Llega hoy a las ocho."],
 "c10": ["Entonces sí hay lugar.", "Nomás no para mí."],
 "c11": ["Lo de su mamá ya estaba platicado.", "No empieces, papá."],
 "c12": ["No vengo a pelear, hijo.", "Vengo a pedir un techo."],
 "c13": ["No es nomás el techo.", "Es la comida, la ropa, los cuidados."],
 "c14": ["Yo me hago mis cosas.", "Hasta les ayudo en la cocina."],
 "c15": ["Mejor váyase con Ciriaco.", "Para eso tiene otro hijo."],
 "c16": ["Ciriaco vive en un cuartito.", "Tú lo sabes, Raymundo."],
 "c17": ["Aunque sea esta noche, hijo.", "Mañana me voy temprano."],
 "c18": ["Hoy es una noche, mañana un mes.", "Ya sabemos cómo acaba eso."],
 "c19": ["Ella ya me dijo que no.", "¿Tú quieres que me vaya?"],
 "r1": [],
 "c20": ["Sí, papá.", "Es lo mejor para todos."],
 "c21": ["Está bien, hijo, me voy.", "Ojalá nunca toques puertas así."],
 "i02": [],
 "c22": ["¿Apá? ¿Qué hace aquí a esta hora?", "¿Por qué trae los ojos así?"],
 "c23": ["Necesito dónde quedarme, mijo.", "Pero si no hay lugar…"],
 "c24": ["Pásele, apá, aquí cabemos.", "Felícitas, ven tantito."],
 "c25": ["Pásele, don Hilario.", "Esta también es su casa."],
 "c26": ["¿De dónde viene caminando?", "¿No fue con mi hermano?"],
 "c27": ["De allá vengo, mijo.", "Llega su suegra esta noche."],
 "c28": ["¿Y usted no cabía?", "Si esa casa tiene seis cuartos."],
 "c29": ["¿Ya cenó, don Hilario?", "Le caliento unos frijolitos."],
 "c30": ["Con un cafecito estoy bien.", "No quiero estorbar."],
 "c31": ["Usted duerme en nuestra cama.", "Mientras yo tenga techo, usted también."],
 "r2": [],
 "i03": [],
 "c32": ["El dueño quiere el cuartito, viejo.", "Para su sobrino, este mes."],
 "c33": ["Mañana vendo la cortadora.", "Con eso buscamos otro lugar."],
 "c34": ["Con esa cortadora trabajas.", "¿Y luego qué vas a hacer?"],
 "c35": ["Que mi apá no se entere.", "Ya bastante le dolió hoy."],
 "r3": [],
 "i04": [],
 "c36": ["Licenciado Villagómez, soy Hilario.", "Mañana a las nueve, en la notaría."],
 "c37": ["Ya sé cuál de mis hijos…", "se va a quedar con todo."],
 "c38": ["¿Ustedes a cuál de los dos le dejarían todo?", "Dale me gusta y sígueme para la segunda parte."]
}
