[
 {
  "i": 0,
  "t0": 0,
  "t1": 0.5,
  "set": "road",
  "line": "In this town,"
 },
 {
  "i": 1,
  "t0": 0.5,
  "t1": 2.2399999999999998,
  "set": "road",
  "line": "nobody crosses the road without Miss Dot."
 },
 {
  "i": 2,
  "t0": 2.2399999999999998,
  "t1": 3.82,
  "set": "road",
  "line": "The road runs right through the middle of town,"
 },
 {
  "i": 3,
  "t0": 3.82,
  "t1": 4.640000000000001,
  "set": "road",
  "line": "and it never ends."
 },
 {
  "i": 4,
  "t0": 4.640000000000001,
  "t1": 5.640000000000001,
  "set": "road",
  "line": "The cars have no drivers,"
 },
 {
  "i": 5,
  "t0": 5.640000000000001,
  "t1": 6.840000000000001,
  "set": "road",
  "line": "and they never, ever brake."
 },
 {
  "i": 6,
  "t0": 6.840000000000001,
  "t1": 7.7,
  "set": "road",
  "line": "Except for one thing."
 },
 {
  "i": 7,
  "t0": 7.7,
  "t1": 8.74,
  "set": "road",
  "line": "Miss Dot's stop sign."
 },
 {
  "i": 8,
  "t0": 8.74,
  "t1": 10.879999999999999,
  "set": "road",
  "line": "She's been walking kids across for eighty years."
 },
 {
  "i": 9,
  "t0": 10.879999999999999,
  "t1": 11.979999999999999,
  "set": "road",
  "line": "Same orange vest."
 },
 {
  "i": 10,
  "t0": 11.979999999999999,
  "t1": 12.879999999999999,
  "set": "road",
  "line": "Same little whistle."
 },
 {
  "i": 11,
  "t0": 12.879999999999999,
  "t1": 14.6,
  "set": "road",
  "line": "Everything else crosses the hard way."
 },
 {
  "i": 12,
  "t0": 14.6,
  "t1": 15.979999999999999,
  "set": "road",
  "line": "Pizza comes over by catapult."
 },
 {
  "i": 13,
  "t0": 15.979999999999999,
  "t1": 17.44,
  "set": "road",
  "line": "Weddings happen on both sides of the road."
 },
 {
  "i": 14,
  "t0": 17.44,
  "t1": 18.3,
  "set": "road",
  "line": "The vows are shouted."
 },
 {
  "i": 15,
  "t0": 18.3,
  "t1": 21.380000000000003,
  "set": "road",
  "line": "Two old twins have waved at each other across the lanes for sixty years."
 },
 {
  "i": 16,
  "t0": 21.380000000000003,
  "t1": 22.28,
  "set": "road",
  "line": "They've never hugged."
 },
 {
  "i": 17,
  "t0": 22.28,
  "t1": 23.880000000000003,
  "set": "road",
  "line": "My name is Rudy, and I count everything."
 },
 {
  "i": 18,
  "t0": 23.880000000000003,
  "t1": 25.64,
  "set": "road",
  "line": "Steps, stairs, cars, my own freckles."
 },
 {
  "i": 19,
  "t0": 25.64,
  "t1": 26.46,
  "set": "road",
  "line": "I can't help it."
 },
 {
  "i": 20,
  "t0": 26.46,
  "t1": 28.18,
  "set": "road",
  "line": "And Miss Dot has three rules."
 },
 {
  "i": 21,
  "t0": 28.18,
  "t1": 28.84,
  "set": "road",
  "line": "Hold hands."
 },
 {
  "i": 22,
  "t0": 28.84,
  "t1": 29.360000000000003,
  "set": "road",
  "line": "Eyes forward."
 },
 {
  "i": 23,
  "t0": 29.360000000000003,
  "t1": 30.76,
  "set": "road",
  "line": "And never, ever count the children."
 },
 {
  "i": 24,
  "t0": 30.76,
  "t1": 32.059999999999995,
  "set": "road",
  "line": "That last one was hard for me."
 },
 {
  "i": 25,
  "t0": 32.059999999999995,
  "t1": 34.16,
  "set": "road",
  "line": "So I counted them anyway, quietly, in my head."
 },
 {
  "i": 26,
  "t0": 34.16,
  "t1": 36.559999999999995,
  "set": "road",
  "line": "Because every morning, thirty-one kids line up on our side."
 },
 {
  "i": 27,
  "t0": 36.559999999999995,
  "t1": 38.5,
  "set": "road",
  "line": "And every morning, thirty-one kids make it to school."
 },
 {
  "i": 28,
  "t0": 38.5,
  "t1": 39.68,
  "set": "road",
  "line": "Except one day a year,"
 },
 {
  "i": 29,
  "t0": 39.68,
  "t1": 40.26,
  "set": "road",
  "line": "the first snow."
 },
 {
  "i": 30,
  "t0": 40.26,
  "t1": 42.059999999999995,
  "set": "road",
  "line": "On the first snow, only thirty make it across."
 },
 {
  "i": 31,
  "t0": 42.059999999999995,
  "t1": 42.559999999999995,
  "set": "hallway",
  "line": "Every year,"
 },
 {
  "i": 32,
  "t0": 42.559999999999995,
  "t1": 43.48,
  "set": "hallway",
  "line": "nobody talks about it."
 },
 {
  "i": 33,
  "t0": 43.48,
  "t1": 45.36,
  "set": "hallway",
  "line": "The school just puts up a new photo in the hallway."
 },
 {
  "i": 34,
  "t0": 45.36,
  "t1": 47.3,
  "set": "road",
  "line": "My big brother, Wes, always crosses last."
 },
 {
  "i": 35,
  "t0": 47.3,
  "t1": 49.93,
  "set": "road",
  "line": "He says somebody has to make sure nobody gets left behind."
 },
 {
  "i": 36,
  "t0": 49.93,
  "t1": 52.169999999999995,
  "set": "road",
  "line": "Then one morning, I woke up, and the world was white."
 },
 {
  "i": 37,
  "t0": 52.169999999999995,
  "t1": 52.849999999999994,
  "set": "road",
  "line": "First snow."
 },
 {
  "i": 38,
  "t0": 52.849999999999994,
  "t1": 53.87,
  "set": "road",
  "line": "Miss Dot blew her whistle."
 },
 {
  "i": 39,
  "t0": 53.87,
  "t1": 54.73,
  "set": "road",
  "line": "She looked down the line,"
 },
 {
  "i": 40,
  "t0": 54.73,
  "t1": 55.9,
  "set": "road",
  "line": "and she smiled at Wes."
 },
 {
  "i": 41,
  "t0": 55.9,
  "t1": 57.54,
  "set": "road",
  "line": "You close the line today, sweetie."
 },
 {
  "i": 42,
  "t0": 57.54,
  "t1": 58.379999999999995,
  "set": "road",
  "line": "Wes winked at me."
 },
 {
  "i": 43,
  "t0": 58.379999999999995,
  "t1": 59.699999999999996,
  "set": "road",
  "line": "Relax, Rudy. It's just snow."
 },
 {
  "i": 44,
  "t0": 59.699999999999996,
  "t1": 60.239999999999995,
  "set": "road",
  "line": "I counted."
 },
 {
  "i": 45,
  "t0": 60.239999999999995,
  "t1": 61.3,
  "set": "road",
  "line": "Thirty-one kids on our side."
 },
 {
  "i": 46,
  "t0": 61.3,
  "t1": 62.8,
  "set": "road",
  "line": "Then I looked across the road."
 },
 {
  "i": 47,
  "t0": 62.8,
  "t1": 64.38,
  "set": "road",
  "line": "The teacher was holding the door open."
 },
 {
  "i": 48,
  "t0": 64.38,
  "t1": 65.82,
  "set": "road",
  "line": "And she'd set out thirty chairs."
 },
 {
  "i": 49,
  "t0": 65.82,
  "t1": 67.92,
  "set": "road",
  "line": "So I grabbed the stop sign right out of Miss Dot's hands,"
 },
 {
  "i": 50,
  "t0": 67.92,
  "t1": 69.34,
  "set": "road",
  "line": "and I held it up as high as I could."
 },
 {
  "i": 51,
  "t0": 69.34,
  "t1": 70.88,
  "set": "road",
  "line": "The cars didn't even slow down."
 },
 {
  "i": 52,
  "t0": 70.88,
  "t1": 72.84,
  "set": "road",
  "line": "They don't stop for the sign. They never did."
 },
 {
  "i": 53,
  "t0": 72.84,
  "t1": 73.7,
  "set": "road",
  "line": "And that's when I saw it."
 },
 {
  "i": 54,
  "t0": 73.7,
  "t1": 74.58,
  "set": "road",
  "line": "Miss Dot's pocket."
 },
 {
  "i": 55,
  "t0": 74.58,
  "t1": 76.6,
  "set": "road",
  "line": "A stack of little name tags, one for every year."
 },
 {
  "i": 56,
  "t0": 76.6,
  "t1": 77.17999999999999,
  "set": "road",
  "line": "Eighty of them."
 },
 {
  "i": 57,
  "t0": 77.17999999999999,
  "t1": 78.28,
  "set": "road",
  "line": "She wasn't stopping the cars."
 },
 {
  "i": 58,
  "t0": 78.28,
  "t1": 79.16,
  "set": "road",
  "line": "She was feeding them."
 },
 {
  "i": 59,
  "t0": 79.16,
  "t1": 80.32,
  "set": "road",
  "line": "The line was already moving."
 },
 {
  "i": 60,
  "t0": 80.32,
  "t1": 80.96,
  "set": "road",
  "line": "Hold hands."
 },
 {
  "i": 61,
  "t0": 80.96,
  "t1": 81.66,
  "set": "road",
  "line": "Eyes forward."
 },
 {
  "i": 62,
  "t0": 81.66,
  "t1": 82.53999999999999,
  "set": "road",
  "line": "Wes at the back."
 },
 {
  "i": 63,
  "t0": 82.53999999999999,
  "t1": 83.84,
  "set": "road",
  "line": "I ran into the road."
 },
 {
  "i": 64,
  "t0": 83.84,
  "t1": 86.08,
  "set": "road",
  "line": "A car came screaming at me with its horn blaring."
 },
 {
  "i": 65,
  "t0": 86.08,
  "t1": 87.98,
  "set": "road",
  "line": "Then somebody shoved me back onto the sidewalk."
 },
 {
  "i": 66,
  "t0": 87.98,
  "t1": 88.22,
  "set": "road",
  "line": "Wes."
 },
 {
  "i": 67,
  "t0": 88.22,
  "t1": 89.02,
  "set": "road",
  "line": "He took the sign,"
 },
 {
  "i": 68,
  "t0": 89.02,
  "t1": 91.17999999999999,
  "set": "road",
  "line": "and he stood right in the middle of the road, and he held it up."
 },
 {
  "i": 69,
  "t0": 91.17999999999999,
  "t1": 92.27,
  "set": "road",
  "line": "And he didn't look back."
 },
 {
  "i": 70,
  "t0": 92.27,
  "t1": 93.78999999999999,
  "set": "road",
  "line": "Thirty kids made it across."
 },
 {
  "i": 71,
  "t0": 93.78999999999999,
  "t1": 94.39,
  "set": "road",
  "line": "Wes didn't."
 },
 {
  "i": 72,
  "t0": 94.39,
  "t1": 96.50999999999999,
  "set": "hallway",
  "line": "The next morning, there was a new photo in the hallway."
 },
 {
  "i": 73,
  "t0": 96.50999999999999,
  "t1": 98.42999999999999,
  "set": "road",
  "line": "And Miss Dot was waiting for me at the curb."
 },
 {
  "i": 74,
  "t0": 98.42999999999999,
  "t1": 100.14999999999999,
  "set": "road",
  "line": "She put her orange vest on my shoulders."
 },
 {
  "i": 75,
  "t0": 100.14999999999999,
  "t1": 101.42999999999999,
  "set": "road",
  "line": "She put the whistle in my hand."
 },
 {
  "i": 76,
  "t0": 101.42999999999999,
  "t1": 104.28999999999999,
  "set": "road",
  "line": "You're good with numbers, sweetie. The road will need someone after me."
 },
 {
  "i": 77,
  "t0": 104.28999999999999,
  "t1": 106.64999999999999,
  "set": "road",
  "line": "A brand new name tag was sticking out of her pocket."
 },
 {
  "i": 78,
  "t0": 106.64999999999999,
  "t1": 107.47,
  "set": "road",
  "line": "It started to snow."
 },
 {
  "i": 79,
  "t0": 107.47,
  "t1": 108.81,
  "set": "road",
  "line": "Thirty kids lined up behind me."
 },
 {
  "i": 80,
  "t0": 108.81,
  "t1": 110.07,
  "set": "road",
  "line": "So tell me, do I count?"
 }
]