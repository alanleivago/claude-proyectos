 "r4": [],
 "c32": ["Patrón, esa troca blanca…", "Es la de su hijo."],
 "c33": ["¿Leobardo?", "¿Mi propio hijo rentó el río?"],
 "c34": ["¿Ustedes qué harían con Leobardo?", "Dale me gusta y sígueme para la segunda parte."]
