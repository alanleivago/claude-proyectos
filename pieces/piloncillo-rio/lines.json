{
 "i01": [],
 "c01": ["Diez minutos, viejito.", "O te regresas por donde viniste."],
 "c02": ["Ese piloncillo lo hizo mi gente.", "Desde las cuatro de la mañana."],
 "c03": ["Aquí ya no se cruza gratis.", "Me dejas la mitad de la carga."],
 "c04": ["Cuarenta años cruzando este río.", "Y nunca nadie me cobró."],
 "c05": ["Pues ahora el paso es mío.", "Me lo rentaron, viejito."],
 "c06": ["¿Quién te rentó el río?", "El río no tiene dueño."],
 "c07": ["Eso no te importa.", "Mi jefe sabe quién eres."],
 "i02": [],
 "c08": ["Joven, ese señor es don Fortino.", "Mejor déjelo pasar."],
 "c09": ["Tú cállate, Crispín.", "Y cuida tu cadena."],
 "r1": [],
 "c10": ["¿Y tú, Crispín?", "¿Ahora trabajas para él?"],
 "c11": ["Me quitaron la balsa, don Fortino.", "Era esto o nada."],
 "c12": ["¿Don Fortino? Mírate nomás.", "Huaraches y una troca vieja."],
 "c13": ["Quita esa cadena, muchacho.", "Antes que espese el piloncillo."],
 "c14": ["¿Cuál piloncillo, viejito?", "¿Y quién te va a ayudar?"],
 "c15": ["En mi molienda ya están batiendo.", "Si no llego, vienen por mí."],
 "c16": ["Yo no veo a nadie.", "No te creo nada, viejito."],
 "c17": ["No me creas.", "Nomás huele el aire."],
 "i03": [],
 "c18": ["Ya espesó el piloncillo.", "Y el patrón no ha cruzado."],
 "c19": ["Prendan las camionetas, muchachos.", "Nos vamos al paso del río."],
 "i04": [],
 "c20": ["Se te acabó el tiempo.", "Da la vuelta, viejito."],
 "c21": ["Ya huele a piloncillo, muchacho.", "Ahí vienen."],
 "c22": ["Joven, ¿oye eso?", "Vienen camionetas por el río."],
 "r2": [],
 "i05": [],
 "i06": [],
 "c23": ["Patrón, ¿está bien?", "¿Quién le cerró el paso?"],
 "c24": ["¿Patrón? ¿Él es el patrón?", "Nadie me dijo nada."],
 "c25": ["Crispín, súbete a tu balsa.", "Hoy cruzas tú primero."],
 "c26": ["Gracias, don Fortino.", "Usted nunca se olvida de uno."],
 "c27": ["¿Diez minutos me diste, Rigoberto?", "Ahora son tuyos."],
 "c28": ["Abre esa cadena.", "Y hoy mismo te vas del río."],
 "c29": ["Yo nomás cumplo órdenes.", "Mi jefe me rentó el paso."],
 "c30": ["¿Y quién es tu jefe?", "Dímelo de frente."],
 "c31": ["Él mismo se lo va a decir.", "Está en la otra orilla."],
