{
 "i01": [],
 "c01": ["Media hora, don Cheyo.", "Y esta lancha es mía."],
 "c02": ["Licenciado, no tire mi pescado.", "Usted no sabe lo que hace."],
 "c03": ["Sé que no tiene papeles.", "La multa son cuarenta mil."],
 "i02": [],
 "c04": ["Los papeles los tiene el dueño.", "Yo nomás la trabajo."],
 "c05": ["¿Dueño? Tú eres pescador, viejo.", "Aquí el dueño soy yo."],
 "c06": ["Licenciado, es para la Nochebuena.", "Déjenos sacar el pescado."],
 "c07": ["Tú no te metas, muchacha.", "El pescado también se queda."],
 "c08": ["Sí, señor. Ya mero.", "Hoy mismo es suya."],
 "r1": [],
 "c09": ["Licenciado, usted acaba de llegar.", "Esa lancha no se toca."],
 "c10": ["Tú nomás cuidas el radio.", "Y te callas, Tiburcio."],
 "c11": ["Tiburcio, préstame el radio.", "Nomás una llamada."],
 "c12": ["Llama a quien quieras, viejo.", "Te quedan veinte minutos."],
 "r2": [],
 "c13": ["Aquí la Golondrina, patrón.", "Vinieron por su lancha."],
 "c14": ["¿Su lancha? ¿Cuál patrón?", "Aquí no hay más patrón."],
 "c15": ["Apá, ¿a quién le habló?", "¿Quién es ese patrón?"],
 "c16": ["Ya lo vas a ver, mija.", "Tú quédate tranquila."],
 "r3": [],
 "c17": ["Quince minutos, viejo.", "Y la lancha se va."],
 "c18": ["¿Vinieron por mi Golondrina?", "Ahorita voy para allá."],
 "i03": [],
 "c19": ["Licenciado, mire para el mar.", "Ya vienen las lanchas."],
 "c20": ["¿Y esas lanchas?", "¿De quién son?"],
 "i04": [],
 "i05": [],
 "c21": ["Buenos días, Cheyo.", "¿Quién tiró tu pescado?"],
 "c22": ["Señor, esa lancha no tiene papeles.", "Son cuarenta mil de multa."],
 "c23": ["Esa lancha es mía, licenciado.", "Los papeles los tengo yo."],
 "c24": ["Cuarenta años se la cuidé.", "Como usted me pidió, patrón."],
 "c25": ["Este hombre me sacó del mar.", "Cuando nadie quiso meterse."],
 "c26": ["Ese día le di la Golondrina.", "Y nadie se la quita."],
 "c27": ["Don Arcadio, yo no sabía.", "Me dijeron que era de nadie."],
 "c28": ["¿Quién te dijo, licenciado?", "¿Quién te mandó?"],
 "r4": [],
 "c29": ["Patrón, hace rato habló por teléfono.", "Dijo: hoy mismo es suya."],
 "c30": ["Tienes hasta que suba la marea.", "Para decirme quién fue."],
 "c31": ["Perdóname por tardar, Cheyo.", "Esta Nochebuena cenas conmigo."],
 "i06": [],
 "c32": ["Patrón, otra vez le marcan.", "Es el mismo de hace rato."],
 "c33": ["Dame ese teléfono, licenciado.", "Quiero ver quién es."],
 "i07": [],
 "c34": ["¿Mi hermano Abelardo?", "¿Él quería mi Golondrina?"],
 "r5": [],
 "c35": ["¿Ustedes creen que don Arcadio debe perdonar a su hermano?", "Denle me gusta y compartan para ver la segunda parte."]
}
