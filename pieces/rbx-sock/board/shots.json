[
 {
  "i": 0,
  "t0": 0,
  "t1": 0.48000000000000004,
  "set": "street",
  "line": "In this town,"
 },
 {
  "i": 1,
  "t0": 0.48000000000000004,
  "t1": 1.5,
  "set": "street",
  "line": "you never lose a sock."
 },
 {
  "i": 2,
  "t0": 1.5,
  "t1": 3.06,
  "set": "laundry",
  "line": "You see, every sock that goes missing"
 },
 {
  "i": 3,
  "t0": 3.06,
  "t1": 4.44,
  "set": "laundry",
  "line": "ends up with the sock man."
 },
 {
  "i": 4,
  "t0": 4.44,
  "t1": 6.04,
  "set": "laundry",
  "line": "And the day he has both socks of a pair,"
 },
 {
  "i": 5,
  "t0": 6.04,
  "t1": 7.12,
  "set": "laundry",
  "line": "he comes up the laundry chute"
 },
 {
  "i": 6,
  "t0": 7.12,
  "t1": 8.18,
  "set": "bedroom",
  "line": "for the feet that go in them."
 },
 {
  "i": 7,
  "t0": 8.18,
  "t1": 10.42,
  "set": "street",
  "line": "So nobody here takes their socks off. Ever."
 },
 {
  "i": 8,
  "t0": 10.42,
  "t1": 11.44,
  "set": "bedroom",
  "line": "We sleep in them."
 },
 {
  "i": 9,
  "t0": 11.44,
  "t1": 12.32,
  "set": "bathroom",
  "line": "We shower in them."
 },
 {
  "i": 10,
  "t0": 12.32,
  "t1": 13.1,
  "set": "hospital",
  "line": "When a baby's born,"
 },
 {
  "i": 11,
  "t0": 13.1,
  "t1": 14.76,
  "set": "hospital",
  "line": "the nurse puts the socks on before the hat."
 },
 {
  "i": 12,
  "t0": 14.76,
  "t1": 15.68,
  "set": "street",
  "line": "The mailman ties his"
 },
 {
  "i": 13,
  "t0": 15.68,
  "t1": 16.78,
  "set": "street",
  "line": "to his ankles with string."
 },
 {
  "i": 14,
  "t0": 16.78,
  "t1": 19.42,
  "set": "street",
  "line": "Mr. Ortega counts his out loud every morning on the porch."
 },
 {
  "i": 15,
  "t0": 19.42,
  "t1": 21.12,
  "set": "street",
  "line": "Left! Right! Left! Right!"
 },
 {
  "i": 16,
  "t0": 21.12,
  "t1": 22.580000000000002,
  "set": "street",
  "line": "The whole street can hear him."
 },
 {
  "i": 17,
  "t0": 22.580000000000002,
  "t1": 23.5,
  "set": "street",
  "line": "Grandma knits her socks"
 },
 {
  "i": 18,
  "t0": 23.5,
  "t1": 24.66,
  "set": "street",
  "line": "straight onto her feet."
 },
 {
  "i": 19,
  "t0": 24.66,
  "t1": 25.580000000000002,
  "set": "street",
  "line": "She hasn't seen her toes"
 },
 {
  "i": 20,
  "t0": 25.580000000000002,
  "t1": 26.740000000000002,
  "set": "street",
  "line": "since 1971."
 },
 {
  "i": 21,
  "t0": 26.740000000000002,
  "t1": 27.84,
  "set": "street",
  "line": "She says she doesn't miss them."
 },
 {
  "i": 22,
  "t0": 27.84,
  "t1": 28.6,
  "set": "classroom",
  "line": "And at school,"
 },
 {
  "i": 23,
  "t0": 28.6,
  "t1": 30,
  "set": "classroom",
  "line": "there's a sock check at the door."
 },
 {
  "i": 24,
  "t0": 30,
  "t1": 30.740000000000002,
  "set": "classroom",
  "line": "If one's missing,"
 },
 {
  "i": 25,
  "t0": 30.740000000000002,
  "t1": 31.44,
  "set": "street",
  "line": "you go home."
 },
 {
  "i": 26,
  "t0": 31.44,
  "t1": 32.559999999999995,
  "set": "laundry",
  "line": "And your mom goes through the dryer"
 },
 {
  "i": 27,
  "t0": 32.559999999999995,
  "t1": 33.62,
  "set": "laundry",
  "line": "with a flashlight."
 },
 {
  "i": 28,
  "t0": 33.62,
  "t1": 35.26,
  "set": "laundry",
  "line": "Nobody's ever seen the sock man."
 },
 {
  "i": 29,
  "t0": 35.26,
  "t1": 35.98,
  "set": "laundry",
  "line": "But some nights,"
 },
 {
  "i": 30,
  "t0": 35.98,
  "t1": 37.82,
  "set": "laundry",
  "line": "the drain in the laundry room makes a sound."
 },
 {
  "i": 31,
  "t0": 37.82,
  "t1": 39.059999999999995,
  "set": "laundry",
  "line": "Like somebody counting."
 },
 {
  "i": 32,
  "t0": 39.059999999999995,
  "t1": 40.22,
  "set": "bedroom",
  "line": "I wear this hood every day"
 },
 {
  "i": 33,
  "t0": 40.22,
  "t1": 41.919999999999995,
  "set": "bedroom",
  "line": "and I've never worn a matching pair of socks."
 },
 {
  "i": 34,
  "t0": 41.919999999999995,
  "t1": 42.4,
  "set": "bedroom",
  "line": "Not once."
 },
 {
  "i": 35,
  "t0": 42.4,
  "t1": 43.62,
  "set": "bedroom",
  "line": "Today it's a dinosaur on the left"
 },
 {
  "i": 36,
  "t0": 43.62,
  "t1": 44.72,
  "set": "bedroom",
  "line": "and a pizza on the right."
 },
 {
  "i": 37,
  "t0": 44.72,
  "t1": 45.559999999999995,
  "set": "kitchen",
  "line": "Mom says I dress"
 },
 {
  "i": 38,
  "t0": 45.559999999999995,
  "t1": 46.96,
  "set": "laundry",
  "line": "like the lost and found box."
 },
 {
  "i": 39,
  "t0": 46.96,
  "t1": 48.64,
  "set": "living",
  "line": "My little sister Pip is four."
 },
 {
  "i": 40,
  "t0": 48.64,
  "t1": 50.16,
  "set": "living",
  "line": "She has yellow socks with ducks on them"
 },
 {
  "i": 41,
  "t0": 50.16,
  "t1": 52.059999999999995,
  "set": "living",
  "line": "and she loves them more than anything. More than me, probably."
 },
 {
  "i": 42,
  "t0": 52.059999999999995,
  "t1": 53.419999999999995,
  "set": "living",
  "line": "She also takes them off everywhere."
 },
 {
  "i": 43,
  "t0": 53.419999999999995,
  "t1": 55.22,
  "set": "kitchen",
  "line": "Even at dinner. Which is gross."
 },
 {
  "i": 44,
  "t0": 55.22,
  "t1": 57.48,
  "set": "street",
  "line": "Until one Saturday, she came home from the park"
 },
 {
  "i": 45,
  "t0": 57.48,
  "t1": 58.339999999999996,
  "set": "street",
  "line": "with one bare foot."
 },
 {
  "i": 46,
  "t0": 58.339999999999996,
  "t1": 59.559999999999995,
  "set": "living",
  "line": "The left duck sock was gone."
 },
 {
  "i": 47,
  "t0": 59.559999999999995,
  "t1": 60.059999999999995,
  "set": "living",
  "line": "We looked everywhere"
 },
 {
  "i": 48,
  "t0": 60.059999999999995,
  "t1": 60.8,
  "set": "living",
  "line": "under the couch."
 },
 {
  "i": 49,
  "t0": 60.8,
  "t1": 61.699999999999996,
  "set": "living",
  "line": "Inside the dog."
 },
 {
  "i": 50,
  "t0": 61.699999999999996,
  "t1": 62.5,
  "set": "living",
  "line": "Okay, near the dog."
 },
 {
  "i": 51,
  "t0": 62.5,
  "t1": 62.919999999999995,
  "set": "laundry",
  "line": "That night,"
 },
 {
  "i": 52,
  "t0": 62.919999999999995,
  "t1": 63.919999999999995,
  "set": "laundry",
  "line": "the laundry chute rattled."
 },
 {
  "i": 53,
  "t0": 63.919999999999995,
  "t1": 65.89999999999999,
  "set": "living",
  "line": "Mom bought her 40 new pairs. Didn't matter."
 },
 {
  "i": 54,
  "t0": 65.89999999999999,
  "t1": 66.98,
  "set": "laundry",
  "line": "He wanted the ducks."
 },
 {
  "i": 55,
  "t0": 66.98,
  "t1": 69.02,
  "set": "living",
  "line": "A week later, Pip fell asleep on the couch"
 },
 {
  "i": 56,
  "t0": 69.02,
  "t1": 71,
  "set": "living",
  "line": "and the right duck sock slid off her foot."
 },
 {
  "i": 57,
  "t0": 71,
  "t1": 71.64,
  "set": "living",
  "line": "I watched it crawl"
 },
 {
  "i": 58,
  "t0": 71.64,
  "t1": 72.46,
  "set": "living",
  "line": "across the carpet"
 },
 {
  "i": 59,
  "t0": 72.46,
  "t1": 73.39999999999999,
  "set": "living",
  "line": "and slip into the vent."
 },
 {
  "i": 60,
  "t0": 73.39999999999999,
  "t1": 74.16,
  "set": "living",
  "line": "Now he had a pair."
 },
 {
  "i": 61,
  "t0": 74.16,
  "t1": 74.7,
  "set": "bedroom",
  "line": "At midnight,"
 },
 {
  "i": 62,
  "t0": 74.7,
  "t1": 76.03999999999999,
  "set": "laundry",
  "line": "the dryer turned on by itself."
 },
 {
  "i": 63,
  "t0": 76.03999999999999,
  "t1": 76.42,
  "set": "living",
  "line": "Wet footprints"
 },
 {
  "i": 64,
  "t0": 76.42,
  "t1": 77.52,
  "set": "living",
  "line": "came up the stairs."
 },
 {
  "i": 65,
  "t0": 77.52,
  "t1": 78.56,
  "set": "living",
  "line": "Sock -shaped ones."
 },
 {
  "i": 66,
  "t0": 78.56,
  "t1": 80.32,
  "set": "bedroom",
  "line": "Then an arm came out of the laundry chute."
 },
 {
  "i": 67,
  "t0": 80.32,
  "t1": 81.12,
  "set": "bedroom",
  "line": "Long and gray."
 },
 {
  "i": 68,
  "t0": 81.12,
  "t1": 82.64,
  "set": "bedroom",
  "line": "Made of a thousand old socks."
 },
 {
  "i": 69,
  "t0": 82.64,
  "t1": 83.78,
  "set": "bedroom",
  "line": "It wrapped around Pip's ankle"
 },
 {
  "i": 70,
  "t0": 83.78,
  "t1": 84.46,
  "set": "bedroom",
  "line": "and pulled."
 },
 {
  "i": 71,
  "t0": 84.46,
  "t1": 85.88,
  "set": "bedroom",
  "line": "And that's when I realized something."
 },
 {
  "i": 72,
  "t0": 85.88,
  "t1": 87.25999999999999,
  "set": "bedroom",
  "line": "He only comes when he has a pair."
 },
 {
  "i": 73,
  "t0": 87.25999999999999,
  "t1": 88.8,
  "set": "bedroom",
  "line": "And a pair has to match."
 },
 {
  "i": 74,
  "t0": 88.8,
  "t1": 90,
  "set": "bedroom",
  "line": "So I let go of Pip."
 },
 {
  "i": 75,
  "t0": 90,
  "t1": 90.94,
  "set": "chute",
  "line": "I dove into the chute."
 },
 {
  "i": 76,
  "t0": 90.94,
  "t1": 91.42,
  "set": "chute",
  "line": "Down and down."
 },
 {
  "i": 77,
  "t0": 91.42,
  "t1": 92.74,
  "set": "cave",
  "line": "Into a cave of socks bigger than our school."
 },
 {
  "i": 78,
  "t0": 92.74,
  "t1": 93.25999999999999,
  "set": "cave",
  "line": "Gym socks."
 },
 {
  "i": 79,
  "t0": 93.25999999999999,
  "t1": 93.86,
  "set": "cave",
  "line": "Baby socks."
 },
 {
  "i": 80,
  "t0": 93.86,
  "t1": 95.46,
  "set": "cave",
  "line": "One sock that was definitely grandpa's."
 },
 {
  "i": 81,
  "t0": 95.46,
  "t1": 97.12,
  "set": "cave",
  "line": "And right at the top, pinned up like a trophy."
 },
 {
  "i": 82,
  "t0": 97.12,
  "t1": 98,
  "set": "cave",
  "line": "Two yellow ducks."
 },
 {
  "i": 83,
  "t0": 98,
  "t1": 99.42,
  "set": "cave",
  "line": "I pulled off my pizza sock."
 },
 {
  "i": 84,
  "t0": 99.42,
  "t1": 100.89999999999999,
  "set": "cave",
  "line": "I grabbed one duck."
 },
 {
  "i": 85,
  "t0": 100.89999999999999,
  "t1": 101.6,
  "set": "cave",
  "line": "Swap."
 },
 {
  "i": 86,
  "t0": 101.6,
  "t1": 102.39999999999999,
  "set": "cave",
  "line": "Duck."
 },
 {
  "i": 87,
  "t0": 102.39999999999999,
  "t1": 103.03999999999999,
  "set": "cave",
  "line": "Pizza."
 },
 {
  "i": 88,
  "t0": 103.03999999999999,
  "t1": 104.53999999999999,
  "set": "cave",
  "line": "Not a pair."
 },
 {
  "i": 89,
  "t0": 104.53999999999999,
  "t1": 106.08,
  "set": "bedroom",
  "line": "Upstairs, the arm let go of Pip."
 },
 {
  "i": 90,
  "t0": 106.08,
  "t1": 107.98,
  "set": "cave",
  "line": "And down in the dark, the sock man just sat there"
 },
 {
  "i": 91,
  "t0": 107.98,
  "t1": 109.02,
  "set": "cave",
  "line": "holding a duck and a pizza."
 },
 {
  "i": 92,
  "t0": 109.02,
  "t1": 109.94,
  "set": "cave",
  "line": "He looked really confused."
 },
 {
  "i": 93,
  "t0": 109.94,
  "t1": 111.16,
  "set": "street",
  "line": "After that, everything changed."
 },
 {
  "i": 94,
  "t0": 111.16,
  "t1": 113.2,
  "set": "street",
  "line": "Now nobody in this town wears matching socks."
 },
 {
  "i": 95,
  "t0": 113.2,
  "t1": 114.42,
  "set": "street",
  "line": "Grandma only knits lefts."
 },
 {
  "i": 96,
  "t0": 114.42,
  "t1": 116.6,
  "set": "street",
  "line": "Mr. Ortega still counts every morning."
 },
 {
  "i": 97,
  "t0": 116.6,
  "t1": 118.06,
  "set": "street",
  "line": "Left. Left. Left."
 },
 {
  "i": 98,
  "t0": 118.06,
  "t1": 119,
  "set": "bedroom",
  "line": "And every Sunday,"
 },
 {
  "i": 99,
  "t0": 119,
  "t1": 120.62,
  "set": "laundry",
  "line": "we drop one odd sock down the chute."
 },
 {
  "i": 100,
  "t0": 120.62,
  "t1": 122.02,
  "set": "cave",
  "line": "He likes the pizza ones best."
 },
 {
  "i": 101,
  "t0": 122.02,
  "t1": 123.74,
  "set": "street",
  "line": "So if you ever lose a sock,"
 },
 {
  "i": 102,
  "t0": 123.74,
  "t1": 125.68,
  "set": "street",
  "line": "don't go looking for the other one."
 }
]