				<script>
				var $ = jQuery.noConflict();
				$(document).ready(function() {
					$(document).on('click', '.qa-q', function(e) {
						e.preventDefault();
						var el = $(this).next();
						if (el.hasClass('opened')) {
							el.slideUp();
							el.removeClass('opened');
							$(this).find('.arrow').removeClass('aup').addClass('adown');
						} else {
							el.slideDown();
							el.addClass('opened');
							$(this).find('.arrow').removeClass('adown').addClass('aup');
						}
					});
				});
			</script>
		
