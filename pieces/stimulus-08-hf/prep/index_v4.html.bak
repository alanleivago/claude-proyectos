<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=1080,height=1920">
<script src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/gsap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/CustomEase.min.js"></script>
<style>
@font-face{font-family:"DIN Next";src:url("assets/fonts/din-bold.ttf") format("truetype");font-weight:700;font-style:normal}
html,body{margin:0;background:#000}
#root{position:relative;width:1080px;height:1920px;overflow:hidden;background:#000;font-family:"DIN Next",sans-serif;font-weight:700}
.stage{position:absolute;left:0;top:0;width:1080px;height:1920px}
.stage video{position:absolute;left:0;top:0;width:1080px;height:1920px;object-fit:cover}
#outro-w{position:absolute;left:0;top:0;width:1080px;height:1920px;z-index:90}
#outro-w video{width:1080px;height:1920px}
.cap{position:absolute;left:0;width:1080px;text-align:center;overflow:visible}
.ln{font-size:86px;line-height:110px;color:#fff;letter-spacing:-0.6px;white-space:nowrap;
  text-shadow:0 4px 10px rgba(0,0,0,.6),0 0 2px rgba(0,0,0,.3),0 0 12px rgba(255,255,255,.38),0 0 30px rgba(255,255,255,.22)}
.ln.it{font-style:italic;font-size:82px;line-height:102px;padding:0 24px}
.ln.it .cream{padding:0 .22em;margin:0 -.22em}
.bigw{height:200px;text-shadow:none}
.bigw .bwin{font-size:168px;line-height:168px;width:1080px}
.gline.biggl{position:relative;left:0;top:28px;width:540px;margin:0 auto}
.capw{height:108px;text-shadow:none}
.capw .bwin{font-size:94px;line-height:108px;width:1080px;letter-spacing:-0.01em}
.capw .rgb{opacity:.5;filter:blur(7px)}
.capw .rgb.r{transform:translateX(-4px)}
.capw .rgb.c{transform:translateX(4px)}
.sepw{height:26px;position:relative}
.gline.sep{position:relative;left:0;top:25px;width:560px;height:4px;margin:0 auto}
.cream{background:linear-gradient(180deg,#fffef2 0%,#f6f3c4 55%,#e7e98f 100%);-webkit-background-clip:text;background-clip:text;color:transparent;
  text-shadow:none;filter:drop-shadow(0 0 9px rgba(238,240,150,.55)) drop-shadow(0 4px 6px rgba(0,0,0,.55))}
.red{color:#ff3347;text-shadow:0 0 2px rgba(0,0,0,.9),0 0 6px rgba(0,0,0,.75),0 0 18px rgba(255,40,60,.7),0 4px 10px rgba(0,0,0,.7)}
.grn{color:#83ff4e;text-shadow:0 0 16px rgba(120,255,80,.55),0 4px 9px rgba(0,0,0,.6)}
.ln.it .red,.ln.it .grn{font-style:italic}
.bigln{font-size:92px;line-height:112px}
.hook-k,.hook-t{position:absolute;left:0;width:1080px;overflow:visible}
.hook-k{top:255px;text-align:center}
.hook-t{top:770px;text-align:right}
.kin,.tin{display:inline-block;font-size:66px;color:#fff;letter-spacing:-0.6px;
  text-shadow:-3px 0 0 rgba(255,40,80,.55),3px 0 0 rgba(40,200,255,.55),0 4px 10px rgba(0,0,0,.6),0 0 22px rgba(255,255,255,.3)}
.tin{font-size:60px;margin-right:70px}
.big{position:absolute;left:0;top:380px;width:1080px;height:420px;overflow:visible}
.bw{position:absolute;overflow:visible}
.bwin{position:relative;letter-spacing:-0.02em;white-space:nowrap}
.bwin span{position:absolute;left:0;top:0;width:100%}
.bwin span:last-child{position:relative}
.wfill{color:#fff;text-shadow:0 0 3px rgba(0,0,0,.95),0 0 10px rgba(0,0,0,.7),0 0 14px rgba(255,255,255,.55),0 0 34px rgba(255,255,255,.3),0 4px 10px rgba(0,0,0,.6)}
.orw{color:#fff;font-size:1.15em;text-shadow:0 0 10px rgba(255,255,255,.6),0 2px 8px rgba(0,0,0,.9),0 0 3px rgba(0,0,0,.9)}
.burnw{position:absolute;left:0;top:0;width:1080px;height:1920px;mix-blend-mode:screen;pointer-events:none}
.burnw video{width:1080px;height:1920px}
.bigin{position:absolute;left:0;top:0;width:1080px;text-align:center;font-size:330px;line-height:400px;letter-spacing:-10px}
.bigin span{position:absolute;left:0;top:0;width:1080px;text-align:center}
.gfill{background:linear-gradient(180deg,#ffffff 0%,#fbf8dc 45%,#ece88f 100%);-webkit-background-clip:text;background-clip:text;color:transparent;
  filter:drop-shadow(0 0 14px rgba(255,250,190,.65)) drop-shadow(0 0 40px rgba(255,240,160,.35)) drop-shadow(0 6px 10px rgba(0,0,0,.45))}
.rgb{opacity:.42;mix-blend-mode:screen;filter:blur(10px)}
.rgb.r{color:#ff2a55;transform:translateX(-6px)}
.rgb.c{color:#22d4ff;transform:translateX(6px)}
.gline{position:absolute;left:190px;top:395px;width:700px;height:5px;border-radius:3px;
  background:linear-gradient(90deg,rgba(200,255,120,0),#d8ff7a 25%,#ffffff 50%,#d8ff7a 75%,rgba(200,255,120,0));
  box-shadow:0 0 14px rgba(210,255,120,.8),0 0 30px rgba(210,255,120,.5)}
.list{position:absolute;left:150px;top:1120px;width:860px}
.chk{display:flex;align-items:center;height:86px}
.dot{flex:none;width:52px;height:52px;border-radius:50%;background:#22c55e;display:inline-flex;align-items:center;justify-content:center;margin-right:22px;
  box-shadow:0 0 16px rgba(34,197,94,.7),0 3px 8px rgba(0,0,0,.5)}
.dot svg{width:34px;height:34px}
.num{font-size:36px;line-height:36px;color:#fff;font-style:normal}
.rfill{background:linear-gradient(180deg,#ff6a72 0%,#ff2a3c 60%,#d9142a 100%);-webkit-background-clip:text;background-clip:text;color:transparent;
  filter:drop-shadow(0 0 3px rgba(0,0,0,.8)) drop-shadow(0 0 16px rgba(255,40,60,.6)) drop-shadow(0 6px 10px rgba(0,0,0,.5))}
.ct{font-style:italic;text-transform:uppercase;font-size:54px;color:#fff;letter-spacing:-0.4px;white-space:nowrap;
  text-shadow:-3px 0 2px rgba(255,40,80,.6),3px 0 2px rgba(40,200,255,.6),0 0 14px rgba(255,255,255,.5),0 0 32px rgba(255,255,255,.25),0 4px 10px rgba(0,0,0,.65)}
.gline.small{position:relative;left:-20px;top:22px;width:820px;height:4px}
.cap,.list{filter:drop-shadow(0 0 5px rgba(0,0,0,.9)) drop-shadow(0 3px 12px rgba(0,0,0,.65))}   /* white jacket: dark halo keeps every caption readable */
.icon{position:absolute;width:130px;height:130px;filter:drop-shadow(0 0 3px rgba(255,255,255,.8)) drop-shadow(0 0 12px rgba(255,255,255,.45)) drop-shadow(0 10px 14px rgba(0,0,0,.6))}
.icon img{width:130px;height:130px;filter:drop-shadow(0 0 6px rgba(255,255,255,.9)) drop-shadow(0 0 18px rgba(255,255,255,.6)) drop-shadow(0 3px 6px rgba(0,0,0,.6))}
.leakw{position:absolute;left:0;top:0;width:1080px;height:1920px;overflow:hidden;pointer-events:none}
.leak{position:absolute;left:-200px;top:0;width:1480px;height:1920px;mix-blend-mode:screen;
  background:radial-gradient(circle at 25% 40%,rgba(255,150,40,.95),rgba(255,150,40,0) 45%),
             radial-gradient(circle at 70% 65%,rgba(255,60,170,.85),rgba(255,60,170,0) 45%),
             radial-gradient(circle at 55% 20%,rgba(255,240,150,.9),rgba(255,240,150,0) 40%),
             linear-gradient(90deg,rgba(255,200,120,.35),rgba(255,255,255,.15))}

@font-face{font-family:"Europa";src:url("assets/fonts/europa-med.otf") format("opentype");font-weight:500;font-style:normal}
.cap .ln{font-size:83.5px;line-height:90px;letter-spacing:-0.031em;color:#fff;padding:0;
  text-shadow:0 0 1px rgba(0,0,0,.45),5px 7px 12px rgba(0,0,0,.62),0 0 14px rgba(255,255,255,.42),0 0 34px rgba(255,255,255,.2)}
.cap .ln.it{font-style:italic;font-size:83.5px;line-height:90px;padding:0 16px}
.cap .ln.it .cream{background:none;-webkit-background-clip:border-box;background-clip:border-box;color:#fff;filter:none;padding:0;margin:0;
  text-shadow:0 0 1px rgba(0,0,0,.45),5px 7px 12px rgba(0,0,0,.62),0 0 14px rgba(255,255,255,.42),0 0 34px rgba(255,255,255,.2)}
.cap .grn{font-style:italic;color:#78ff00;text-shadow:0 0 1px rgba(0,0,0,.5),5px 7px 12px rgba(0,0,0,.6),0 0 12px rgba(150,255,60,.75),0 0 30px rgba(120,255,0,.4)}
.cap .red{font-style:italic;color:#f92f2f;text-shadow:0 0 2px rgba(0,0,0,.85),5px 7px 12px rgba(0,0,0,.65),0 0 14px rgba(255,50,50,.7),0 0 30px rgba(255,40,40,.35)}
.cap .ln.capw,.cap .ln.bigw{text-shadow:none}
.cap .capw{height:100px}
.cap .capw .bwin{font-size:92px;line-height:100px;letter-spacing:-0.01em;font-style:italic;padding:0 18px;box-sizing:border-box}
.cap .capw .gfill{background:linear-gradient(180deg,#cdc9a9 0%,#f1efe2 50%,#ffffff 94%);-webkit-background-clip:text;background-clip:text;color:transparent;
  filter:drop-shadow(0 0 2px rgba(0,0,0,.55)) drop-shadow(0 0 12px rgba(255,255,240,.45)) drop-shadow(5px 7px 9px rgba(0,0,0,.6))}
.cap .capw .rgb{opacity:.38;filter:blur(4px)}
.cap .capw .bwin span{padding:0 .3em;box-sizing:border-box}   /* italic + background-clip:text: room for the last letter's overhang */
.cap .capw .rgb.r{transform:translateX(-3px)}
.cap .capw .rgb.c{transform:translateX(3px)}
.gfill{background:linear-gradient(180deg,#ece4a0 0%,#fbf8e4 50%,#ffffff 94%);-webkit-background-clip:text;background-clip:text;color:transparent}
.icon{position:absolute;filter:none}
.icon img{width:100%;height:100%;filter:drop-shadow(0 0 2px rgba(0,0,0,.7)) drop-shadow(0 0 5px rgba(255,255,255,.7)) drop-shadow(0 0 16px rgba(255,255,255,.4)) drop-shadow(10px 12px 12px rgba(0,0,0,.8))}
.cfw{position:absolute;left:0;width:1080px;text-align:center;overflow:visible}
.cf1{font-family:"Europa",sans-serif;font-weight:500;font-size:95.6px;line-height:120px;letter-spacing:.006em;color:#fff;white-space:nowrap;
  text-shadow:0 0 1px rgba(0,0,0,.4),6px 9px 14px rgba(0,0,0,.7),0 0 14px rgba(255,255,255,.5),0 0 36px rgba(255,255,255,.22)}
.cf2{font-family:"Europa",sans-serif;font-weight:500;font-size:91px;line-height:120px;letter-spacing:.006em;white-space:nowrap;transform:scale(1.03);transform-origin:50% 70%}
.cf2 span{display:inline-block;font-style:italic;padding:0 .15em;
  background:linear-gradient(180deg,#a7a861 17px,#bdbe83 34px,#f8f8f6 80px,#f8f8f6 120px);-webkit-background-clip:text;background-clip:text;color:transparent;
  filter:drop-shadow(0 0 2px rgba(0,0,0,.7)) drop-shadow(0 0 9px rgba(220,222,150,.35)) drop-shadow(6px 9px 10px rgba(0,0,0,.8))}
.cfj{position:absolute;width:165px;height:165px}
.cfj img{width:165px;height:165px;transform:rotate(8deg);
  filter:brightness(1.6) saturate(1.08) drop-shadow(0 0 10px rgba(60,220,140,.85)) drop-shadow(0 0 34px rgba(40,200,120,.5)) drop-shadow(14px 16px 22px rgba(0,0,0,.75))}


.gfill,.cap .capw .gfill{background:linear-gradient(180deg,#ffffff 0%,#fbf8dc 45%,#ece88f 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
.cream{background:linear-gradient(180deg,#fffef2 0%,#f6f3c4 55%,#e7e98f 100%);-webkit-background-clip:text;background-clip:text;color:transparent}


.brw{position:absolute;left:0;top:0;width:1080px;height:1920px;overflow:hidden;transform-origin:50% 50%}
.brw video{position:absolute;left:0;top:0;width:1080px;height:1920px;object-fit:cover;filter:brightness(.84) contrast(1.06)}
.burnw{position:absolute;left:0;top:0;width:1080px;height:1920px;mix-blend-mode:screen;pointer-events:none}
.burnw video{width:1080px;height:1920px}

.cfj img{filter:brightness(1.6) saturate(1.08) drop-shadow(0 0 10px rgba(255,90,80,.85)) drop-shadow(0 0 34px rgba(255,90,80,.5)) drop-shadow(14px 16px 22px rgba(0,0,0,.75))}
#pickw .gfill{filter:drop-shadow(0 0 3px rgba(0,0,0,.85)) drop-shadow(0 0 14px rgba(255,250,190,.5)) drop-shadow(6px 8px 10px rgba(0,0,0,.7))}
/* white jacket (v4): darker halo under the white icons and the cream CTA line so they read */
.icon img{filter:drop-shadow(0 0 3px rgba(0,0,0,.85)) drop-shadow(0 0 5px rgba(255,255,255,.6)) drop-shadow(0 0 16px rgba(255,255,255,.35)) drop-shadow(10px 12px 12px rgba(0,0,0,.85))}
.cf2 span{filter:drop-shadow(0 0 3px rgba(0,0,0,.85)) drop-shadow(0 0 9px rgba(220,222,150,.3)) drop-shadow(6px 9px 10px rgba(0,0,0,.85))}
</style></head>
<body>
<div id="root" data-composition-id="main" data-start="0" data-duration="52.503" data-width="1080" data-height="1920">
  <div id="stage-v" class="stage" style="z-index:1"><video id="v-edit" class="clip" data-start="0" data-duration="50.467" data-track-index="0" src="assets/edit_v.mp4" playsinline data-has-audio="true"></video></div>
  <div id="stage-c" class="stage" style="z-index:3" data-layout-allow-occlusion><video id="v-cut" class="clip" data-start="0" data-duration="10.4" data-media-start="0" data-track-index="1" src="assets/cutout_pr.webm" muted playsinline data-layout-allow-occlusion></video></div>
  <div id="hk-dir" class="clip bw" data-start="0.260" data-duration="4.146" data-track-index="2" style="z-index:2;left:38px;top:187px;width:1060px" data-layout-allow-overlap>
  <div class="bwin" style="font-size:244px;line-height:280px;text-align:left;width:1060px" data-layout-allow-occlusion data-layout-allow-overlap><span class="rgb r" data-layout-allow-occlusion>COACHES</span><span class="rgb c" data-layout-allow-occlusion>COACHES</span><span class="gfill">COACHES</span></div></div><div id="cap1" class="clip cap" data-start="1.050" data-duration="1.340" data-track-index="3" style="z-index:50;top:1050px"><div class="ln" id="cap1-0" style="font-size:83.5px">has this ever</div><div class="ln it" id="cap1-1" style="font-size:83.5px">happened to you?</div></div><div id="cap2" class="clip cap" data-start="2.410" data-duration="1.966" data-track-index="3" style="z-index:50;top:900px"><div class="ln" id="cap2-0" style="font-size:83.5px">Your team store</div><div class="ln it" id="cap2-1" style="font-size:83.5px"><span class="red">closes after two weeks,</span></div></div><div id="ic3" class="clip icon" data-start="2.410" data-duration="1.966" data-track-index="4" style="z-index:51;left:360px;top:1114px;width:130px;height:130px"><img src="assets/icons/png/store.png" alt=""></div><div id="ic4" class="clip icon" data-start="2.530" data-duration="1.846" data-track-index="4" style="z-index:51;left:590px;top:1114px;width:130px;height:130px"><img src="assets/icons/png/calendar.png" alt=""></div><div id="cap5" class="clip cap" data-start="4.396" data-duration="2.167" data-track-index="3" style="z-index:50;top:900px"><div class="ln" id="cap5-0" style="font-size:83.5px">then a new player joins</div><div class="ln it" id="cap5-1" style="font-size:83.5px">in the middle of</div><div class="ln bigw" id="cap5-2"><div class="bwin" style="font-size:168px" data-layout-allow-occlusion data-layout-allow-overlap><span class="rgb r" data-layout-allow-occlusion>WEEK SIX.</span><span class="rgb c" data-layout-allow-occlusion>WEEK SIX.</span><span class="gfill">WEEK SIX.</span></div><div class="gline biggl"></div></div></div><div id="cap6" class="clip cap" data-start="6.583" data-duration="0.661" data-track-index="3" style="z-index:50;top:916px"><div class="ln" id="cap6-0" style="font-size:83.5px"><span class="red">Now what?</span></div></div><div id="ic7" class="clip icon" data-start="6.583" data-duration="0.661" data-track-index="4" style="z-index:51;left:475px;top:1040px;width:130px;height:130px"><img src="assets/icons/png/choices.png" alt=""></div><div id="cap8" class="clip cap" data-start="7.264" data-duration="1.800" data-track-index="3" style="z-index:50;top:900px"><div class="ln" id="cap8-0" style="font-size:83.5px">This happens</div><div class="ln it" id="cap8-1" style="font-size:83.5px">every single season.</div></div><div id="ic9" class="clip icon" data-start="7.264" data-duration="1.800" data-track-index="4" style="z-index:51;left:475px;top:1114px;width:130px;height:130px"><img src="assets/icons/png/season.png" alt=""></div><div id="cap10" class="clip cap" data-start="9.084" data-duration="2.101" data-track-index="3" style="z-index:50;top:900px"><div class="ln" id="cap10-0" style="font-size:83.5px">The store opens,</div><div class="ln it" id="cap10-1" style="font-size:83.5px">the store <span class="red">closes.</span></div></div><div id="ic11" class="clip icon" data-start="9.254" data-duration="1.931" data-track-index="4" style="z-index:51;left:475px;top:1114px;width:130px;height:130px"><img src="assets/icons/png/store.png" alt=""></div><div id="cap12" class="clip cap" data-start="11.205" data-duration="2.275" data-track-index="3" style="z-index:50;top:900px"><div class="ln" id="cap12-0" style="font-size:83.5px">The orders ship,</div><div class="ln it" id="cap12-1" style="font-size:83.5px">then a new kid shows up,</div></div><div id="ic13" class="clip icon" data-start="11.205" data-duration="2.275" data-track-index="4" style="z-index:51;left:360px;top:1114px;width:130px;height:130px"><img src="assets/icons/png/truck.png" alt=""></div><div id="ic14" class="clip icon" data-start="11.325" data-duration="2.155" data-track-index="4" style="z-index:51;left:590px;top:1114px;width:130px;height:130px"><img src="assets/icons/png/player.png" alt=""></div><div id="cap15" class="clip cap" data-start="13.500" data-duration="2.774" data-track-index="3" style="z-index:50;top:960px"><div class="ln" id="cap15-0" style="font-size:83.5px">and now the coach has to</div><div class="ln it" id="cap15-1" style="font-size:83.5px">place a <span class="red">special order</span></div><div class="ln it" id="cap15-2" style="font-size:83.5px">for one kid.</div></div><div id="cap16" class="clip cap" data-start="16.294" data-duration="2.055" data-track-index="3" style="z-index:50;top:960px"><div class="ln" id="cap16-0" style="font-size:83.5px">Meanwhile,</div><div class="ln it" id="cap16-1" style="font-size:83.5px">the kid&#x27;s playing</div><div class="ln it" id="cap16-2" style="font-size:83.5px"><span class="red">in a pinny.</span></div></div><div id="cap17" class="clip cap" data-start="18.369" data-duration="2.280" data-track-index="3" style="z-index:50;top:950px"><div class="ln" id="cap17-0" style="font-size:83.5px">Here&#x27;s what a</div><div class="ln capw" id="cap17-1"><div class="bwin" style="font-size:92px" data-layout-allow-occlusion data-layout-allow-overlap><span class="rgb r" data-layout-allow-occlusion>GOOD TEAM STORE</span><span class="rgb c" data-layout-allow-occlusion>GOOD TEAM STORE</span><span class="gfill">GOOD TEAM STORE</span></div></div><div class="ln it" id="cap17-2" style="font-size:83.5px">actually does.</div></div><div id="cap18" class="clip cap" data-start="20.669" data-duration="1.630" data-track-index="3" style="z-index:50;top:900px"><div class="ln" id="cap18-0" style="font-size:83.5px">It stays open</div><div class="ln it" id="cap18-1" style="font-size:83.5px"><span class="grn">all season,</span></div></div><div id="ic19" class="clip icon" data-start="20.669" data-duration="1.630" data-track-index="4" style="z-index:51;left:360px;top:1114px;width:130px;height:130px"><img src="assets/icons/png/store.png" alt=""></div><div id="ic20" class="clip icon" data-start="20.789" data-duration="1.510" data-track-index="4" style="z-index:51;left:590px;top:1114px;width:130px;height:130px"><img src="assets/icons/png/season.png" alt=""></div><div id="cap21" class="clip cap" data-start="22.319" data-duration="1.877" data-track-index="3" style="z-index:50;top:900px"><div class="ln" id="cap21-0" style="font-size:83.5px">March, November,</div><div class="ln it" id="cap21-1" style="font-size:83.5px">doesn&#x27;t matter.</div></div><div id="ic22" class="clip icon" data-start="22.369" data-duration="1.827" data-track-index="4" style="z-index:51;left:475px;top:1114px;width:130px;height:130px"><img src="assets/icons/png/calendar.png" alt=""></div><div id="cap23" class="clip cap" data-start="24.216" data-duration="2.000" data-track-index="3" style="z-index:50;top:900px"><div class="ln" id="cap23-0" style="font-size:83.5px">A player joins,</div><div class="ln it" id="cap23-1" style="font-size:83.5px">they <span class="grn">order that night.</span></div></div><div id="ic24" class="clip icon" data-start="24.216" data-duration="2.000" data-track-index="4" style="z-index:51;left:360px;top:1114px;width:130px;height:130px"><img src="assets/icons/png/player.png" alt=""></div><div id="ic25" class="clip icon" data-start="24.336" data-duration="1.880" data-track-index="4" style="z-index:51;left:590px;top:1114px;width:130px;height:130px"><img src="assets/icons/png/ticket.png" alt=""></div><div id="cap26" class="clip cap" data-start="26.236" data-duration="1.580" data-track-index="3" style="z-index:50;top:900px"><div class="ln" id="cap26-0" style="font-size:83.5px">It ships to</div><div class="ln it" id="cap26-1" style="font-size:83.5px">each player&#x27;s door,</div></div><div id="ic27" class="clip icon" data-start="26.426" data-duration="1.390" data-track-index="4" style="z-index:51;left:475px;top:1114px;width:130px;height:130px"><img src="assets/icons/png/truck.png" alt=""></div><div id="cap28" class="clip cap" data-start="27.836" data-duration="1.413" data-track-index="3" style="z-index:50;top:940px"><div class="ln" id="cap28-0" style="font-size:83.5px">and it arrives</div><div class="ln bigw" id="cap28-1"><div class="bwin" style="font-size:168px" data-layout-allow-occlusion data-layout-allow-overlap><span class="rgb r" data-layout-allow-occlusion>FAST.</span><span class="rgb c" data-layout-allow-occlusion>FAST.</span><span class="gfill">FAST.</span></div><div class="gline biggl"></div></div></div><div id="cap29" class="clip cap" data-start="29.269" data-duration="3.120" data-track-index="3" style="z-index:50;top:960px"><div class="ln" id="cap29-0" style="font-size:83.5px">And the store keeps</div><div class="ln it" id="cap29-1" style="font-size:71px">game uniforms and warmups</div><div class="ln it" id="cap29-2" style="font-size:83.5px">all in one link,</div></div><div id="cap30" class="clip cap" data-start="32.409" data-duration="1.165" data-track-index="3" style="z-index:50;top:916px"><div class="ln it" id="cap30-0" style="font-size:83.5px"><span class="grn">all season long.</span></div></div><div id="ic31" class="clip icon" data-start="32.409" data-duration="1.165" data-track-index="4" style="z-index:51;left:475px;top:1040px;width:130px;height:130px"><img src="assets/icons/png/season.png" alt=""></div><div id="cap32" class="clip cap" data-start="33.594" data-duration="2.672" data-track-index="3" style="z-index:50;top:1040px"><div class="ln" id="cap32-0" style="font-size:70px">So ask your uniform company</div><div class="ln capw" id="cap32-1"><div class="bwin" style="font-size:88px" data-layout-allow-occlusion data-layout-allow-overlap><span class="rgb r" data-layout-allow-occlusion>ONE SIMPLE QUESTION.</span><span class="rgb c" data-layout-allow-occlusion>ONE SIMPLE QUESTION.</span><span class="gfill">ONE SIMPLE QUESTION.</span></div></div></div><div id="cap33" class="clip cap" data-start="36.286" data-duration="1.251" data-track-index="3" style="z-index:50;top:900px"><div class="ln" id="cap33-0" style="font-size:83.5px">Does my store</div><div class="ln it" id="cap33-1" style="font-size:83.5px"><span class="red">ever close?</span></div></div><div id="ic34" class="clip icon" data-start="36.286" data-duration="1.251" data-track-index="4" style="z-index:51;left:475px;top:1114px;width:130px;height:130px"><img src="assets/icons/png/store.png" alt=""></div><div id="cap35" class="clip cap" data-start="37.557" data-duration="3.110" data-track-index="3" style="z-index:50;top:960px"><div class="ln" id="cap35-0" style="font-size:83.5px">If the answer is yes,</div><div class="ln it" id="cap35-1" style="font-size:83.5px">get ready for a lot of</div><div class="ln it" id="cap35-2" style="font-size:83.5px"><span class="red">special orders.</span></div></div><div id="cap36" class="clip cap" data-start="40.687" data-duration="1.800" data-track-index="3" style="z-index:50;top:900px"><div class="ln" id="cap36-0" style="font-size:83.5px">Our team stores</div><div class="ln capw" id="cap36-1"><div class="bwin" style="font-size:92px" data-layout-allow-occlusion data-layout-allow-overlap><span class="rgb r" data-layout-allow-occlusion>NEVER CLOSE,</span><span class="rgb c" data-layout-allow-occlusion>NEVER CLOSE,</span><span class="gfill">NEVER CLOSE,</span></div></div></div><div id="ic37" class="clip icon" data-start="40.687" data-duration="1.800" data-track-index="4" style="z-index:51;left:475px;top:1122px;width:130px;height:130px"><img src="assets/icons/png/store.png" alt=""></div><div id="cap38" class="clip cap" data-start="42.507" data-duration="1.447" data-track-index="3" style="z-index:50;top:900px"><div class="ln" id="cap38-0" style="font-size:83.5px">and they don&#x27;t cost you</div><div class="ln it" id="cap38-1" style="font-size:83.5px"><span class="grn">a thing.</span></div></div><div id="ic39" class="clip icon" data-start="42.507" data-duration="1.447" data-track-index="4" style="z-index:51;left:47