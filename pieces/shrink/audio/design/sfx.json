 "rules": [
  {
   "name": "fx.shrink.air",
   "_doc": "the signature halving: a short real air whoosh peaking 40 ms before the 2 s mark, climbing 7 st across the 28 halvings",
   "match": {
    "kind": "shrink",
    "id": "shrink:(?!26)"
   },
   "pool": "fx.p.shr.air",
   "mode": "cycle",
   "gain_db": -19,
   "pitch": [
    0,
    0.3
   ],
   "pitch_ramp": [
    0,
    7
   ],
   "pan": 0,
   "align": "peak",
   "offset": -0.04
  },
  {
   "name": "fx.shrink.pop",
   "_doc": "a mouth pop on the mark, climbing with her",
   "match": {
    "kind": "shrink"
   },
   "pool": "fx.p.shr.pop",
   "mode": "cycle",
   "gain_db": -10,
   "jitter_db": 1,
   "pitch_ramp": [
    0,
    7
   ],
   "pan": 0,
   "align": "attack"
  },
  {
   "name": "fx.step.wood",
   "_doc": "sneakers on the flat's wood floor; the girl is centimetres tall, so the steps lift as she shrinks (pitch_ramp) and thin out (gain_ramp)",
   "match": {
    "kind": "step",
    "variant": "wood"
   },
   "pool": "fx.p.step.wood",
   "mode": "cycle",
   "gain_db": -9,
   "jitter_db": 1.5,
   "pitch": [
    -0.3,
    0.3
   ],
   "pitch_ramp": [
    1,
    5
   ],
   "pan": 0,
   "align": "attack"
  },
