[
 {
  "i": 0,
  "t0": 0,
  "t1": 0.6399999999999999,
  "set": "street",
  "line": "In this town,"
 },
 {
  "i": 1,
  "t0": 0.6399999999999999,
  "t1": 2.28,
  "set": "street",
  "line": "nobody looks up on Thursday nights."
 },
 {
  "i": 2,
  "t0": 2.28,
  "t1": 3.62,
  "set": "street",
  "line": "You see, something lives in the sky,"
 },
 {
  "i": 3,
  "t0": 3.62,
  "t1": 4.98,
  "set": "street",
  "line": "and every time it catches someone looking,"
 },
 {
  "i": 4,
  "t0": 4.98,
  "t1": 6,
  "set": "street",
  "line": "it comes down a little lower."
 },
 {
  "i": 5,
  "t0": 6,
  "t1": 6.78,
  "set": "kitchen",
  "line": "So on Thursdays,"
 },
 {
  "i": 6,
  "t0": 6.78,
  "t1": 8.66,
  "set": "street",
  "line": "the whole town keeps its eyes on the ground."
 },
 {
  "i": 7,
  "t0": 8.66,
  "t1": 10.459999999999999,
  "set": "street",
  "line": "Every window gets boarded up at sunset."
 },
 {
  "i": 8,
  "t0": 10.459999999999999,
  "t1": 11.62,
  "set": "street",
  "line": "The mailman walks his route,"
 },
 {
  "i": 9,
  "t0": 11.62,
  "t1": 12.68,
  "set": "street",
  "line": "staring at his shoes."
 },
 {
  "i": 10,
  "t0": 12.68,
  "t1": 14.32,
  "set": "street",
  "line": "The pizza guy delivers by smell."
 },
 {
  "i": 11,
  "t0": 14.32,
  "t1": 17.080000000000002,
  "set": "street",
  "line": "Mr. Ortega drives to work with a cereal box over his head,"
 },
 {
  "i": 12,
  "t0": 17.080000000000002,
  "t1": 18.560000000000002,
  "set": "street",
  "line": "and somehow he's never been late."
 },
 {
  "i": 13,
  "t0": 18.560000000000002,
  "t1": 20.900000000000002,
  "set": "street",
  "line": "Grandma waters her plants with her eyes closed."
 },
 {
  "i": 14,
  "t0": 20.900000000000002,
  "t1": 22.28,
  "set": "street",
  "line": "She's been doing it for 60 years."
 },
 {
  "i": 15,
  "t0": 22.28,
  "t1": 23.62,
  "set": "street",
  "line": "She's honestly pretty good at it."
 },
 {
  "i": 16,
  "t0": 23.62,
  "t1": 24.82,
  "set": "classroom",
  "line": "And there's a rule at school."
 },
 {
  "i": 17,
  "t0": 24.82,
  "t1": 26.220000000000002,
  "set": "classroom",
  "line": "If you hear the bell on a Thursday,"
 },
 {
  "i": 18,
  "t0": 26.220000000000002,
  "t1": 27.32,
  "set": "classroom",
  "line": "you put your head on the desk"
 },
 {
  "i": 19,
  "t0": 27.32,
  "t1": 28.360000000000003,
  "set": "classroom",
  "line": "and count to a thousand."
 },
 {
  "i": 20,
  "t0": 28.360000000000003,
  "t1": 29.26,
  "set": "street",
  "line": "We call it the Watcher."
 },
 {
  "i": 21,
  "t0": 29.26,
  "t1": 30.580000000000002,
  "set": "classroom",
  "line": "Nobody knows what it looks like."
 },
 {
  "i": 22,
  "t0": 30.580000000000002,
  "t1": 32.04,
  "set": "street",
  "line": "Nobody wants to find out."
 },
 {
  "i": 23,
  "t0": 32.04,
  "t1": 33.239999999999995,
  "set": "bedroom",
  "line": "Me? I'm 10."
 },
 {
  "i": 24,
  "t0": 33.239999999999995,
  "t1": 34.18,
  "set": "bedroom",
  "line": "I wear this hood every day,"
 },
 {
  "i": 25,
  "t0": 34.18,
  "t1": 35.72,
  "set": "classroom",
  "line": "and I'm the best staring contest player"
 },
 {
  "i": 26,
  "t0": 35.72,
  "t1": 36.46,
  "set": "bedroom",
  "line": "in the whole school."
 },
 {
  "i": 27,
  "t0": 36.46,
  "t1": 37.58,
  "set": "classroom",
  "line": "I've never blinked first."
 },
 {
  "i": 28,
  "t0": 37.58,
  "t1": 38.46,
  "set": "bedroom",
  "line": "Not once."
 },
 {
  "i": 29,
  "t0": 38.46,
  "t1": 39.54,
  "set": "bedroom",
  "line": "Not even against my cat."
 },
 {
  "i": 30,
  "t0": 39.54,
  "t1": 40.919999999999995,
  "set": "bedroom",
  "line": "My little sister Pip is four."
 },
 {
  "i": 31,
  "t0": 40.919999999999995,
  "t1": 42.04,
  "set": "bedroom",
  "line": "She doesn't get the rule yet."
 },
 {
  "i": 32,
  "t0": 42.04,
  "t1": 43.94,
  "set": "bedroom",
  "line": "She thinks the boards are there so the house can't see out."
 },
 {
  "i": 33,
  "t0": 43.94,
  "t1": 44.739999999999995,
  "set": "street",
  "line": "Until one Thursday,"
 },
 {
  "i": 34,
  "t0": 44.739999999999995,
  "t1": 46.839999999999996,
  "set": "bedroom",
  "line": "I woke up at midnight because the boards were creaking."
 },
 {
  "i": 35,
  "t0": 46.839999999999996,
  "t1": 47.839999999999996,
  "set": "bedroom",
  "line": "Pip was at the window."
 },
 {
  "i": 36,
  "t0": 47.839999999999996,
  "t1": 49.18,
  "set": "bedroom",
  "line": "She'd pulled one board loose."
 },
 {
  "i": 37,
  "t0": 49.18,
  "t1": 49.66,
  "set": "bedroom",
  "line": "Just one."
 },
 {
  "i": 38,
  "t0": 49.66,
  "t1": 50.76,
  "set": "bedroom",
  "line": "And she was looking up."
 },
 {
  "i": 39,
  "t0": 50.76,
  "t1": 51.94,
  "set": "bedroom",
  "line": "And something was looking back."
 },
 {
  "i": 40,
  "t0": 51.94,
  "t1": 52.699999999999996,
  "set": "street",
  "line": "A face."
 },
 {
  "i": 41,
  "t0": 52.699999999999996,
  "t1": 53.68,
  "set": "street",
  "line": "Bigger than the moon."
 },
 {
  "i": 42,
  "t0": 53.68,
  "t1": 55.36,
  "set": "sky",
  "line": "Gray with two orange eyes."
 },
 {
  "i": 43,
  "t0": 55.36,
  "t1": 56.8,
  "set": "bedroom",
  "line": "I grabbed her and pulled her away,"
 },
 {
  "i": 44,
  "t0": 56.8,
  "t1": 57.72,
  "set": "bedroom",
  "line": "but it was too late."
 },
 {
  "i": 45,
  "t0": 57.72,
  "t1": 58.44,
  "set": "bedroom",
  "line": "It had seen us."
 },
 {
  "i": 46,
  "t0": 58.44,
  "t1": 60.28,
  "set": "street",
  "line": "The next Thursday, it was lower."
 },
 {
  "i": 47,
  "t0": 60.28,
  "t1": 61.559999999999995,
  "set": "street",
  "line": "Right behind the church bell."
 },
 {
  "i": 48,
  "t0": 61.559999999999995,
  "t1": 63.62,
  "set": "street",
  "line": "The Thursday after that, it was over the treetops."
 },
 {
  "i": 49,
  "t0": 63.62,
  "t1": 65.17999999999999,
  "set": "street",
  "line": "The whole street could hear it breathing."
 },
 {
  "i": 50,
  "t0": 65.17999999999999,
  "t1": 66.62,
  "set": "kitchen",
  "line": "Dad nailed more boards."
 },
 {
  "i": 51,
  "t0": 66.62,
  "t1": 67.16,
  "set": "kitchen",
  "line": "Then more."
 },
 {
  "i": 52,
  "t0": 67.16,
  "t1": 68.14,
  "set": "kitchen",
  "line": "Mom stopped sleeping."
 },
 {
  "i": 53,
  "t0": 68.14,
  "t1": 69.74,
  "set": "street",
  "line": "The neighbors started packing their cars."
 },
 {
  "i": 54,
  "t0": 69.74,
  "t1": 70.58,
  "set": "bedroom",
  "line": "I tried everything."
 },
 {
  "i": 55,
  "t0": 70.58,
  "t1": 72.44,
  "set": "street",
  "line": "I wrote go away on our roof in chalk."
 },
 {
  "i": 56,
  "t0": 72.44,
  "t1": 73.25999999999999,
  "set": "street",
  "line": "It came lower."
 },
 {
  "i": 57,
  "t0": 73.25999999999999,
  "t1": 75.67999999999999,
  "set": "bedroom",
  "line": "I covered Pip's window with every blanket we had."
 },
 {
  "i": 58,
  "t0": 75.67999999999999,
  "t1": 76.42,
  "set": "street",
  "line": "It came lower."
 },
 {
  "i": 59,
  "t0": 76.42,
  "t1": 77.34,
  "set": "kitchen",
  "line": "On the last Thursday,"
 },
 {
  "i": 60,
  "t0": 77.34,
  "t1": 79.25999999999999,
  "set": "street",
  "line": "it was so low the shingles rattled."
 },
 {
  "i": 61,
  "t0": 79.25999999999999,
  "t1": 81.88,
  "set": "bedroom",
  "line": "And it pressed one giant eye right against our window."
 },
 {
  "i": 62,
  "t0": 81.88,
  "t1": 83.58,
  "set": "bedroom",
  "line": "And that's when I realized something."
 },
 {
  "i": 63,
  "t0": 83.58,
  "t1": 86.12,
  "set": "classroom",
  "line": "The rule says it comes down when it catches you looking,"
 },
 {
  "i": 64,
  "t0": 86.12,
  "t1": 88.78,
  "set": "classroom",
  "line": "but it never says what happens if you don't stop looking."
 },
 {
  "i": 65,
  "t0": 88.78,
  "t1": 90.75999999999999,
  "set": "street",
  "line": "So I climbed out onto the roof,"
 },
 {
  "i": 66,
  "t0": 90.75999999999999,
  "t1": 92.08,
  "set": "street",
  "line": "And I stared."
 },
 {
  "i": 67,
  "t0": 92.08,
  "t1": 93.56,
  "set": "sky",
  "line": "It stared back."
 },
 {
  "i": 68,
  "t0": 93.56,
  "t1": 94.56,
  "set": "street",
  "line": "One minute."
 },
 {
  "i": 69,
  "t0": 94.56,
  "t1": 95.96,
  "set": "street",
  "line": "Ten minutes."
 },
 {
  "i": 70,
  "t0": 95.96,
  "t1": 97.14,
  "set": "street",
  "line": "An hour."
 },
 {
  "i": 71,
  "t0": 97.14,
  "t1": 98.16,
  "set": "street",
  "line": "My eyes burned."
 },
 {
  "i": 72,
  "t0": 98.16,
  "t1": 98.96,
  "set": "street",
  "line": "The wind was freezing."
 },
 {
  "i": 73,
  "t0": 98.96,
  "t1": 99.52,
  "set": "street",
  "line": "I didn't blink."
 },
 {
  "i": 74,
  "t0": 99.52,
  "t1": 101.39999999999999,
  "set": "street",
  "line": "Then it did something nobody in this town had ever seen."
 },
 {
  "i": 75,
  "t0": 101.39999999999999,
  "t1": 101.84,
  "set": "sky",
  "line": "It blinked."
 },
 {
  "i": 76,
  "t0": 101.84,
  "t1": 102.36,
  "set": "street",
  "line": "And it went up."
 },
 {
  "i": 77,
  "t0": 102.36,
  "t1": 103.39999999999999,
  "set": "street",
  "line": "Past the treetops."
 },
 {
  "i": 78,
  "t0": 103.39999999999999,
  "t1": 104.46,
  "set": "street",
  "line": "Past the church bell."
 },
 {
  "i": 79,
  "t0": 104.46,
  "t1": 107.12,
  "set": "street",
  "line": "All the way up until it was just a tiny gray dot."
 },
 {
  "i": 80,
  "t0": 107.12,
  "t1": 108.25999999999999,
  "set": "street",
  "line": "After that, everything changed."
 },
 {
  "i": 81,
  "t0": 108.25999999999999,
  "t1": 109.1,
  "set": "street",
  "line": "Now on Thursday nights,"
 },
 {
  "i": 82,
  "t0": 109.1,
  "t1": 110.88,
  "set": "street",
  "line": "the whole town climbs onto their roofs."
 },
 {
  "i": 83,
  "t0": 110.88,
  "t1": 111.98,
  "set": "street",
  "line": "Grandma brings cookies."
 },
 {
  "i": 84,
  "t0": 111.98,
  "t1": 113.86,
  "set": "street",
  "line": "The pizza guy finally sees where he's going."
 },
 {
  "i": 85,
  "t0": 113.86,
  "t1": 115.06,
  "set": "street",
  "line": "And we all stare at the sky."
 },
 {
  "i": 86,
  "t0": 115.06,
  "t1": 115.53999999999999,
  "set": "street",
  "line": "Together."
 },
 {
  "i": 87,
  "t0": 115.53999999999999,
  "t1": 116.64,
  "set": "sky",
  "line": "It hasn't come back."
 },
 {
  "i": 88,
  "t0": 116.64,
  "t1": 117.32,
  "set": "street",
  "line": "But some Fridays."
 },
 {
  "i": 89,
  "t0": 117.32,
  "t1": 119.72,
  "set": "sky",
  "line": "I swear I see it up there practicing."
 }
]