 "lines": [
  {
   "id": "l01",
   "text": "Your dog is stressed, and it might be your fault.",
   "file": "l01.wav",
   "take": 1
  },
  {
   "id": "l02",
   "text": "Swedish scientists collected hair from fifty-eight dogs and their owners.",
   "file": "l02.wav",
   "take": 5
  },
  {
   "id": "l03",
   "text": "Hair stores the stress hormone cortisol, months of it at a time.",
   "file": "l03.wav",
   "take": 1
  },
  {
   "id": "l04",
   "text": "Stressed owners had stressed dogs.",
   "file": "l04.wav",
   "take": 1
  },
  {
   "id": "l05",
   "text": "Calm owners had calm dogs.",
   "file": "l05.wav",
   "take": 1
  },
  {
   "id": "l06",
   "text": "It held in winter, and again in summer.",
   "file": "l06.wav",
   "take": 2
  },
  {
   "id": "l07",
   "text": "They even put activity collars on the dogs, in case exercise explained it.",
   "file": "l07.wav",
   "take": 1
  },
  {
   "id": "l08",
   "text": "It didn't.",
   "file": "l08.wav",
   "take": 1
  },
  {
   "id": "l09",
   "text": "But the owner's personality did.",
   "file": "l09.wav",
   "take": 1
  },
  {
   "id": "l10",
   "text": "The dog's own personality barely mattered.",
   "file": "l10.wav",
   "take": 1
  },
  {
   "id": "l11",
   "text": "The boss who yells at you,",
   "file": "l11.wav",
   "take": 2
  },
  {
   "id": "l12",
   "text": "the bills, the traffic,",
   "file": "l12.wav",
   "take": 1
  },
  {
   "id": "l13",
   "text": "your dog ends up carrying some of it.",
   "file": "l13.wav",
   "take": 1
  },
  {
   "id": "l14",
   "text": "So if you've had a rough week, just know,",
   "file": "l14.wav",
   "take": 2
  }
 ]
}