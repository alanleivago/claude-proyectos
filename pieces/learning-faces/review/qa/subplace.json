[
 {
  "key": "2.00",
  "text": "In 1960, two men reached the deepest / point on Earth.",
  "x": 1452,
  "y": 880,
  "w": 739.0000000000005,
  "h": 102,
  "cost": 0.652
 },
 {
  "key": "10.27",
  "text": "Before the sand clouded the window, / one of them saw something",
  "x": 456,
  "y": 352,
  "w": 722.8000000000004,
  "h": 102,
  "cost": 1.229
 },
 {
  "key": "13.74",
  "text": "on the bottom.",
  "x": 444,
  "y": 520,
  "w": 307.6,
  "h": 66,
  "cost": 0.433
 },
 {
  "key": "18.44",
  "text": "They had no camera.",
  "x": 300,
  "y": 688,
  "w": 415.60000000000014,
  "h": 66,
  "cost": 0.564
 },
 {
  "key": "19.75",
  "text": "Nobody believed him.",
  "x": 300,
  "y": 664,
  "w": 422.8000000000002,
  "h": 66,
  "cost": 0.67
 },
 {
  "key": "24.84",
  "text": "Sixty years later, / a research team went back.",
  "x": 660,
  "y": 736,
  "w": 559.0000000000002,
  "h": 102,
  "cost": 0.553
 },
 {
  "key": "28.00",
  "text": "With cameras this time.",
  "x": 684,
  "y": 688,
  "w": 471.4000000000002,
  "h": 66,
  "cost": 0.55
 },
 {
  "key": "33.55",
  "text": "On the first dive, / the lights caught a pale shape at",
  "x": 420,
  "y": 856,
  "w": 657.4000000000003,
  "h": 102,
  "cost": 0.159
 },
 {
  "key": "36.40",
  "text": "the edge of the dark.",
  "x": 1080,
  "y": 208,
  "w": 433.00000000000017,
  "h": 66,
  "cost": 0.006
 },
 {
  "key": "41.45",
  "text": "It didn't swim away.",
  "x": 612,
  "y": 352,
  "w": 404.8000000000001,
  "h": 66,
  "cost": 0.144
 },
 {
  "key": "42.88",
  "text": "It held still.",
  "x": 696,
  "y": 208,
  "w": 247.59999999999997,
  "h": 66,
  "cost": 0.014
 },
 {
  "key": "43.93",
  "text": "Like it was watching.",
  "x": 552,
  "y": 304,
  "w": 424.00000000000017,
  "h": 66,
  "cost": 0.25
 },
 {
  "key": "50.61",
  "text": "On the second dive, / it had a face.",
  "x": 600,
  "y": 808,
  "w": 397.60000000000014,
  "h": 102,
  "cost": 0.993
 },
 {
  "key": "56.85",
  "text": "Two holes for eyes.",
  "x": 300,
  "y": 640,
  "w": 400.60000000000014,
  "h": 66,
  "cost": 0.264
 },
 {
  "key": "58.12",
  "text": "A slit for a mouth.",
  "x": 492,
  "y": 160,
  "w": 370.6,
  "h": 66,
  "cost": 0.169
 },
 {
  "key": "59.39",
  "text": "Like a child's / drawing of a person.",
  "x": 348,
  "y": 232,
  "w": 422.8000000000002,
  "h": 102,
  "cost": 0.493
 },
 {
  "key": "65.56",
  "text": "Every time the pilot moved, / it moved the same way.",
  "x": 1416,
  "y": 688,
  "w": 536.2000000000003,
  "h": 102,
  "cost": 0.259
 },
 {
  "key": "72.52",
  "text": "A second too late.",
  "x": 924,
  "y": 904,
  "w": 375.4000000000001,
  "h": 66,
  "cost": 0.086
 },
 {
  "key": "77.45",
  "text": "But the strangest part wasn't that it / copied them.",
  "x": 1464,
  "y": 856,
  "w": 722.2000000000005,
  "h": 102,
  "cost": 0.799
 },
 {
  "key": "84.53",
  "text": "It was that it was getting better at it.",
  "x": 468,
  "y": 904,
  "w": 746.8000000000005,
  "h": 66,
  "cost": 0.784
 },
 {
  "key": "90.33",
  "text": "Dive three: eyelids.",
  "x": 288,
  "y": 232,
  "w": 392.8000000000002,
  "h": 66,
  "cost": 0.187
 },
 {
  "key": "92.03",
  "text": "Dive four: eyebrows, / lips, teeth.",
  "x": 1620,
  "y": 376,
  "w": 413.8000000000001,
  "h": 102,
  "cost": 0.213
 },
 {
  "key": "98.63",
  "text": "The marine biologist said it / was a known species.",
  "x": 1560,
  "y": 112,
  "w": 534.4000000000003,
  "h": 102,
  "cost": 0.483
 },
 {
  "key": "101.74",
  "text": "She couldn't name it.",
  "x": 756,
  "y": 160,
  "w": 421.00000000000017,
  "h": 66,
  "cost": 0.436
 },
 {
  "key": "106.91",
  "text": "On dive five, / it smiled at the camera.",
  "x": 336,
  "y": 616,
  "w": 475.60000000000025,
  "h": 102,
  "cost": 0.352
 },
 {
  "key": "113.34",
  "text": "The crew realized it wasn't copying / faces in general.",
  "x": 444,
  "y": 520,
  "w": 692.8000000000004,
  "h": 102,
  "cost": 1.376
 },
 {
  "key": "120.45",
  "text": "It was copying theirs.",
  "x": 1320,
  "y": 832,
  "w": 443.20000000000016,
  "h": 66,
  "cost": 1.803
 },
 {
  "key": "125.37",
  "text": "The pilot refused to go down again.",
  "x": 1476,
  "y": 688,
  "w": 692.8000000000003,
  "h": 66,
  "cost": 0.605
 },
 {
  "key": "131.37",
  "text": "So the cameraman went alone.",
  "x": 396,
  "y": 280,
  "w": 603.4000000000003,
  "h": 66,
  "cost": 0.177
 },
 {
  "key": "136.76",
  "text": "The tape recovered from that dive is 41 / minutes long.",
  "x": 1440,
  "y": 112,
  "w": 769.6000000000005,
  "h": 102,
  "cost": 1.608
 },
 {
  "key": "144.11",
  "text": "For forty minutes, / there's only dark water.",
  "x": 960,
  "y": 160,
  "w": 484.60000000000025,
  "h": 102,
  "cost": 0
 },
 {
  "key": "152.25",
  "text": "Then the cameraman / turns the camera",
  "x": 324,
  "y": 376,
  "w": 414.4000000000001,
  "h": 102,
  "cost": 0.074
 },
 {
  "key": "154.34",
  "text": "toward himself.",
  "x": 396,
  "y": 808,
  "w": 323.80000000000007,
  "h": 66,
  "cost": 0.095
 },
 {
  "key": "159.12",
  "text": "He's smiling.",
  "x": 1692,
  "y": 592,
  "w": 261.4,
  "h": 66,
  "cost": 0.179
 },
 {
  "key": "162.90",
  "text": "It wasn't his face.",
  "x": 1644,
  "y": 760,
  "w": 373.60000000000014,
  "h": 66,
  "cost": 0.23
 },
 {
  "key": "169.60",
  "text": "The sub came back up on its own.",
  "x": 432,
  "y": 904,
  "w": 665.2000000000004,
  "h": 66,
  "cost": 0.637
 },
 {
  "key": "171.72",
  "text": "The cabin was empty.",
  "x": 432,
  "y": 784,
  "w": 434.8000000000002,
  "h": 66,
  "cost": 0.429
 },
 {
  "key": "176.95",
  "text": "The project was shut down.",
  "x": 1188,
  "y": 328,
  "w": 553.0000000000002,
  "h": 66,
  "cost": 0.119
 },
 {
  "key": "178.66",
  "text": "The footage was classified.",
  "x": 1188,
  "y": 328,
  "w": 548.2000000000003,
  "h": 66,
  "cost": 0.195
 },
 {
  "key": "184.34",
  "text": "Piccard never went back down.",
  "x": 408,
  "y": 544,
  "w": 622.6000000000004,
  "h": 66,
  "cost": 0.198
 },
 {
  "key": "186.32",
  "text": "Until he died, / he never described what he saw.",
  "x": 468,
  "y": 664,
  "w": 658.0000000000003,
  "h": 102,
  "cost": 0.333
 },
 {
  "key": "193.29",
  "text": "Somewhere at the bottom, / something has three faces now.",
  "x": 960,
  "y": 160,
  "w": 635.8000000000003,
  "h": 102,
  "cost": 0.464
 },
 {
  "key": "200.42",
  "text": "Maybe the question isn't what it is.",
  "x": 444,
  "y": 184,
  "w": 694.0000000000005,
  "h": 66,
  "cost": 1.489
 },
 {
  "key": "202.77",
  "text": "Maybe it's whose face it wants next.",
  "x": 1464,
  "y": 112,
  "w": 727.0000000000003,
  "h": 66,
  "cost": 1.596
 }
]