[
 {
  "i": 0,
  "t0": 0,
  "t1": 0.5800000000000001,
  "set": "kingdom",
  "line": "In this kingdom,"
 },
 {
  "i": 1,
  "t0": 0.5800000000000001,
  "t1": 2.31,
  "set": "kingdom",
  "line": "you can only move like your chess piece."
 },
 {
  "i": 2,
  "t0": 2.31,
  "t1": 3.41,
  "set": "kingdom",
  "line": "Rooks are the taxis,"
 },
 {
  "i": 3,
  "t0": 3.41,
  "t1": 4.41,
  "set": "kingdom",
  "line": "straight lines only."
 },
 {
  "i": 4,
  "t0": 4.41,
  "t1": 5.430000000000001,
  "set": "kingdom",
  "line": "Fastest ride in the kingdom"
 },
 {
  "i": 5,
  "t0": 5.430000000000001,
  "t1": 6.95,
  "set": "kingdom",
  "line": "as long as you don't need to turn."
 },
 {
  "i": 6,
  "t0": 6.95,
  "t1": 8.37,
  "set": "kingdom",
  "line": "My aunt is a white square bishop."
 },
 {
  "i": 7,
  "t0": 8.37,
  "t1": 9.87,
  "set": "kingdom",
  "line": "She married a black square bishop."
 },
 {
  "i": 8,
  "t0": 9.87,
  "t1": 10.93,
  "set": "kingdom",
  "line": "They've never held hands."
 },
 {
  "i": 9,
  "t0": 10.93,
  "t1": 11.629999999999999,
  "set": "kingdom",
  "line": "They wave."
 },
 {
  "i": 10,
  "t0": 11.629999999999999,
  "t1": 13.229999999999999,
  "set": "kingdom",
  "line": "And every Sunday is game night."
 },
 {
  "i": 11,
  "t0": 13.229999999999999,
  "t1": 14.45,
  "set": "kingdom",
  "line": "The clouds slide back like a lid."
 },
 {
  "i": 12,
  "t0": 14.45,
  "t1": 15.07,
  "set": "kingdom",
  "line": "A hand comes down"
 },
 {
  "i": 13,
  "t0": 15.07,
  "t1": 16.470000000000002,
  "set": "kingdom",
  "line": "and it drops one of us in the box."
 },
 {
  "i": 14,
  "t0": 16.470000000000002,
  "t1": 17.87,
  "set": "kingdom",
  "line": "Nothing comes back out of the box."
 },
 {
  "i": 15,
  "t0": 17.87,
  "t1": 18.610000000000003,
  "set": "kingdom",
  "line": "My dad's a knight."
 },
 {
  "i": 16,
  "t0": 18.610000000000003,
  "t1": 19.470000000000002,
  "set": "kingdom",
  "line": "He moves in an L"
 },
 {
  "i": 17,
  "t0": 19.470000000000002,
  "t1": 20.69,
  "set": "kingdom",
  "line": "and he can jump over things."
 },
 {
  "i": 18,
  "t0": 20.69,
  "t1": 22.76,
  "set": "kingdom",
  "line": "So some mornings he lands on the baker's roof."
 },
 {
  "i": 19,
  "t0": 22.76,
  "t1": 23.580000000000002,
  "set": "kingdom",
  "line": "I'm a pawn."
 },
 {
  "i": 20,
  "t0": 23.580000000000002,
  "t1": 24.700000000000003,
  "set": "kingdom",
  "line": "One square a day. Forward,"
 },
 {
  "i": 21,
  "t0": 24.700000000000003,
  "t1": 25.540000000000003,
  "set": "kingdom",
  "line": "I'm on row seven."
 },
 {
  "i": 22,
  "t0": 25.540000000000003,
  "t1": 26.62,
  "set": "kingdom",
  "line": "Dad never could walk me to school."
 },
 {
  "i": 23,
  "t0": 26.62,
  "t1": 27.26,
  "set": "kingdom",
  "line": "Jump. Land,"
 },
 {
  "i": 24,
  "t0": 27.26,
  "t1": 28.48,
  "set": "kingdom",
  "line": "wait for me. Jump. Took us forever."
 },
 {
  "i": 25,
  "t0": 28.48,
  "t1": 30.1,
  "set": "kingdom",
  "line": "However, tiny print at the bottom of the rule book."
 },
 {
  "i": 26,
  "t0": 30.1,
  "t1": 31.52,
  "set": "kingdom",
  "line": "If a pawn reaches the last row,"
 },
 {
  "i": 27,
  "t0": 31.52,
  "t1": 32.559999999999995,
  "set": "kingdom",
  "line": "it can become anything."
 },
 {
  "i": 28,
  "t0": 32.559999999999995,
  "t1": 33.76,
  "set": "kingdom",
  "line": "No pawn ever has."
 },
 {
  "i": 29,
  "t0": 33.76,
  "t1": 34.78,
  "set": "kingdom",
  "line": "We get captured first."
 },
 {
  "i": 30,
  "t0": 34.78,
  "t1": 36.58,
  "set": "kingdom",
  "line": "This Sunday, the hand came down over our street."
 },
 {
  "i": 31,
  "t0": 36.58,
  "t1": 37.32,
  "set": "kingdom",
  "line": "Past the bakery."
 },
 {
  "i": 32,
  "t0": 37.32,
  "t1": 38.64,
  "set": "kingdom",
  "line": "Past my aunt and uncle waving."
 },
 {
  "i": 33,
  "t0": 38.64,
  "t1": 39.559999999999995,
  "set": "kingdom",
  "line": "And it stopped right over me."
 },
 {
  "i": 34,
  "t0": 39.559999999999995,
  "t1": 41.14,
  "set": "kingdom",
  "line": "Dad jumped. Two over. One up."
 },
 {
  "i": 35,
  "t0": 41.14,
  "t1": 41.879999999999995,
  "set": "kingdom",
  "line": "Right in front of me."
 },
 {
  "i": 36,
  "t0": 41.879999999999995,
  "t1": 42.989999999999995,
  "set": "kingdom",
  "line": "The hand took him instead."
 },
 {
  "i": 37,
  "t0": 42.989999999999995,
  "t1": 44.15,
  "set": "kingdom",
  "line": "I tried everything."
 },
 {
  "i": 38,
  "t0": 44.15,
  "t1": 44.89,
  "set": "kingdom",
  "line": "I asked a rook."
 },
 {
  "i": 39,
  "t0": 44.89,
  "t1": 45.91,
  "set": "kingdom",
  "line": "Straight lines only, kid."
 },
 {
  "i": 40,
  "t0": 45.91,
  "t1": 46.89,
  "set": "kingdom",
  "line": "The box is diagonal."
 },
 {
  "i": 41,
  "t0": 46.89,
  "t1": 47.61,
  "set": "kingdom",
  "line": "I asked my aunt."
 },
 {
  "i": 42,
  "t0": 47.61,
  "t1": 48.449999999999996,
  "set": "kingdom",
  "line": "She can go diagonal."
 },
 {
  "i": 43,
  "t0": 48.449999999999996,
  "t1": 49.449999999999996,
  "set": "kingdom",
  "line": "She can't carry a pawn."
 },
 {
  "i": 44,
  "t0": 49.449999999999996,
  "t1": 50.349999999999994,
  "set": "kingdom",
  "line": "I went all the way to the queen."
 },
 {
  "i": 45,
  "t0": 50.349999999999994,
  "t1": 51.169999999999995,
  "set": "kingdom",
  "line": "She can go anywhere."
 },
 {
  "i": 46,
  "t0": 51.169999999999995,
  "t1": 52.309999999999995,
  "set": "kingdom",
  "line": "She looked down at me and said,"
 },
 {
  "i": 47,
  "t0": 52.309999999999995,
  "t1": 53.669999999999995,
  "set": "kingdom",
  "line": "pawns don't get rescues."
 },
 {
  "i": 48,
  "t0": 53.669999999999995,
  "t1": 54.669999999999995,
  "set": "kitchen",
  "line": "I even asked the king."
 },
 {
  "i": 49,
  "t0": 54.669999999999995,
  "t1": 55.57,
  "set": "kitchen",
  "line": "He said he'd love to help,"
 },
 {
  "i": 50,
  "t0": 55.57,
  "t1": 56.669999999999995,
  "set": "kitchen",
  "line": "but he's been trying to leave his kitchen"
 },
 {
  "i": 51,
  "t0": 56.669999999999995,
  "t1": 57.87,
  "set": "kitchen",
  "line": "since 1987."
 },
 {
  "i": 52,
  "t0": 57.87,
  "t1": 59.37,
  "set": "kingdom",
  "line": "And I can only move one square."
 },
 {
  "i": 53,
  "t0": 59.37,
  "t1": 60.53,
  "set": "kingdom",
  "line": "So I looked at row eight."
 },
 {
  "i": 54,
  "t0": 60.53,
  "t1": 61.41,
  "set": "kingdom",
  "line": "Nothing but fog."
 },
 {
  "i": 55,
  "t0": 61.41,
  "t1": 62.71,
  "set": "kingdom",
  "line": "No pawn has ever stepped in it."
 },
 {
  "i": 56,
  "t0": 62.71,
  "t1": 63.65,
  "set": "kingdom",
  "line": "I took one step."
 },
 {
  "i": 57,
  "t0": 63.65,
  "t1": 64.67,
  "set": "kingdom",
  "line": "The fog cleared,"
 },
 {
  "i": 58,
  "t0": 64.67,
  "t1": 66.25,
  "set": "kingdom",
  "line": "and the whole kingdom was staring at me."
 },
 {
  "i": 59,
  "t0": 66.25,
  "t1": 67.61,
  "set": "kingdom",
  "line": "Well, everyone who could get there in time."
 },
 {
  "i": 60,
  "t0": 67.61,
  "t1": 68.69,
  "set": "kingdom",
  "line": "The rooks got there first."
 },
 {
  "i": 61,
  "t0": 68.69,
  "t1": 70.41,
  "set": "kingdom",
  "line": "A voice from the sky asked, what do you want to be?"
 },
 {
  "i": 62,
  "t0": 70.41,
  "t1": 72.31,
  "set": "kingdom",
  "line": "Everybody expected a knight. Like dad,"
 },
 {
  "i": 63,
  "t0": 72.31,
  "t1": 72.75,
  "set": "kingdom",
  "line": "queen."
 },
 {
  "i": 64,
  "t0": 72.75,
  "t1": 73.89,
  "set": "kingdom",
  "line": "And I walked sideways."
 },
 {
  "i": 65,
  "t0": 73.89,
  "t1": 74.78999999999999,
  "set": "kingdom",
  "line": "Then backwards."
 },
 {
  "i": 66,
  "t0": 74.78999999999999,
  "t1": 75.71,
  "set": "kingdom",
  "line": "Then diagonally,"
 },
 {
  "i": 67,
  "t0": 75.71,
  "t1": 76.85,
  "set": "kingdom",
  "line": "all the way across the board,"
 },
 {
  "i": 68,
  "t0": 76.85,
  "t1": 77.88,
  "set": "kingdom",
  "line": "straight to the box."
 },
 {
  "i": 69,
  "t0": 77.88,
  "t1": 79.14,
  "set": "box",
  "line": "Inside, it was dark and wooden,"
 },
 {
  "i": 70,
  "t0": 79.14,
  "t1": 81.53999999999999,
  "set": "box",
  "line": "and stacked to the ceiling with every piece ever captured."
 },
 {
  "i": 71,
  "t0": 81.53999999999999,
  "t1": 83.6,
  "set": "box",
  "line": "Some had been in there so long they'd lost their color."
 },
 {
  "i": 72,
  "t0": 83.6,
  "t1": 84.74,
  "set": "box",
  "line": "Dad was right. Dad was right on top."
 },
 {
  "i": 73,
  "t0": 84.74,
  "t1": 86.12,
  "set": "box",
  "line": "But the walls were way too high."
 },
 {
  "i": 74,
  "t0": 86.12,
  "t1": 87.34,
  "set": "box",
  "line": "A queen can go anywhere,"
 },
 {
  "i": 75,
  "t0": 87.34,
  "t1": 88.67,
  "set": "box",
  "line": "as long as nothing's in the way."
 },
 {
  "i": 76,
  "t0": 88.67,
  "t1": 89.83,
  "set": "box",
  "line": "A knight can jump."
 },
 {
  "i": 77,
  "t0": 89.83,
  "t1": 90.97,
  "set": "box",
  "line": "Dad grabbed me and jumped."
 },
 {
  "i": 78,
  "t0": 90.97,
  "t1": 92.03,
  "set": "kingdom",
  "line": "Over the wall. Over the street."
 },
 {
  "i": 79,
  "t0": 92.03,
  "t1": 92.92999999999999,
  "set": "kingdom",
  "line": "Onto the baker's roof."
 },
 {
  "i": 80,
  "t0": 92.92999999999999,
  "t1": 94.17,
  "set": "kingdom",
  "line": "The baker didn't even look up."
 },
 {
  "i": 81,
  "t0": 94.17,
  "t1": 95.73,
  "set": "kingdom",
  "line": "Up in the sky, the hand stopped."
 },
 {
  "i": 82,
  "t0": 95.73,
  "t1": 97.25,
  "set": "kingdom",
  "line": "Then it slowly went back behind the clouds."
 },
 {
  "i": 83,
  "t0": 97.25,
  "t1": 99.09,
  "set": "kingdom",
  "line": "Now I can go anywhere I want, in any direction,"
 },
 {
  "i": 84,
  "t0": 99.09,
  "t1": 100.07,
  "set": "kingdom",
  "line": "as far as I want."
 },
 {
  "i": 85,
  "t0": 100.07,
  "t1": 101.00999999999999,
  "set": "kingdom",
  "line": "But every morning,"
 },
 {
  "i": 86,
  "t0": 101.00999999999999,
  "t1": 102.37,
  "set": "kingdom",
  "line": "dad and I still walk to school in an L"
 },
 {
  "i": 87,
  "t0": 102.37,
  "t1": 103.47,
  "set": "kingdom",
  "line": "jump. Land. Wait. Jump."
 },
 {
  "i": 88,
  "t0": 103.47,
  "t1": 104.27,
  "set": "kingdom",
  "line": "It takes us forever."
 },
 {
  "i": 89,
  "t0": 104.27,
  "t1": 105.51,
  "set": "kingdom",
  "line": "Best part of my day."
 }
]