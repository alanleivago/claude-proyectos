 "r4": [],
 "c32": ["Don Anastasio, la del balcón…", "Es su nieta Leocadia."],
 "c33": ["¿Leocadia?", "¿Le diste el anillo de tu abuela?"],
 "c34": ["Si ustedes fueran don Anastasio… ¿la perdonan?", "Dale me gusta y sígueme, que la segunda parte se pone buena."]
