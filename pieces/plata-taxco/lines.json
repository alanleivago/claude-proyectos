 "c01": ["Antes que prendan los faroles, maestro.", "Ni el viejo de la mina lo salva."],
 "c02": ["Este taller no se vende, señor.", "Aquí trabajo hace treinta años."],
 "c03": ["Treinta años de puro polvo.", "Mañana aquí pongo mi joyería."],
 "c04": ["Esas piezas eran para la feria.", "Me tardé meses en hacerlas."],
 "c05": ["Pues recójalas del suelo, viejo.", "Ya le quedan pocas horas."],
 "c06": ["Usted no tiene ningún papel.", "Este local es de la mina."],
 "c07": ["Alguien de arriba me lo dio.", "Mire nomás qué anillito."],
 "i02": [],
 "c08": ["Yo hice ese anillo, señor.", "¿De dónde lo sacó?"],
 "c09": ["Eso no le importa, maestro.", "Usted firme y se va."],
 "c10": ["Señor, déjelo trabajar en paz.", "Es un hombre bueno."],
 "c11": ["Tú no te metas, muchacha.", "Ve a barrer el taller."],
 "r1": [],
 "c12": ["Eufrosina, métete al taller.", "Mándale la foto a don Anastasio."],
 "c13": ["Sí, maestro.", "Ahorita mismo se la mando."],
 "c14": ["¿A don Anastasio?", "Si ese ya ni baja del cerro."],
 "c15": ["Usted no lo conoce, señor.", "No lo haga bajar, se lo pido."],
 "c16": ["Siéntese, maestro, y mire.", "Ya van prendiendo los faroles."],
 "i03": [],
 "c17": ["¿Las piezas de Severiano?", "¿Tiradas en la calle?"],
 "c18": ["Dejen la mina, muchachos.", "Todos conmigo al taller."],
 "i04": [],
 "c19": ["Ya prendió el último farol.", "Ándele, firme de una vez."],
 "c20": ["Maestro, mire la calle.", "Se llenó de camionetas blancas."],
 "c21": ["Ahí está, señor.", "Ya bajaron los del cerro."],
 "r2": [],
 "i05": [],
 "i06": [],
 "c22": ["¿Quién tiró el trabajo del maestro?", "Dígamelo a la cara."],
 "c23": ["Don Anastasio, buenas noches.", "Me juraron que usted no bajaba."],
 "c24": ["Severiano, ¿te lastimaron?", "Perdóname la tardanza, compadre."],
 "c25": ["Estoy entero, don Anastasio.", "Nomás me tiraron las piezas."],
 "c26": ["Tú hiciste nuestros anillos de bodas.", "Cuando yo no tenía nada."],
 "c27": ["Mira los faroles, Gumaro.", "Ya se te prendieron a ti."],
 "c28": ["Te doy lo mismo que le diste.", "Antes que amanezca, te vas de Taxco."],
 "c29": ["A mí me abrieron la puerta.", "Alguien de su propia casa."],
 "c30": ["En mi casa nadie me falla.", "¿Quién te dio ese anillo?"],
 "c31": ["Voltee para arriba, don.", "Está en mi balcón."],
 "r3": [],
