[
 {
  "i": 0,
  "t0": 0,
  "t1": 0.6000000000000001,
  "set": "city",
  "line": "In this world,"
 },
 {
  "i": 1,
  "t0": 0.6000000000000001,
  "t1": 2.08,
  "set": "city",
  "line": "everyone is holding the same rope."
 },
 {
  "i": 2,
  "t0": 2.08,
  "t1": 3.18,
  "set": "city",
  "line": "It runs through every city,"
 },
 {
  "i": 3,
  "t0": 3.18,
  "t1": 4.180000000000001,
  "set": "coast",
  "line": "across every ocean,"
 },
 {
  "i": 4,
  "t0": 4.180000000000001,
  "t1": 5.760000000000001,
  "set": "front",
  "line": "and into the fog at the edge of the world."
 },
 {
  "i": 5,
  "t0": 5.760000000000001,
  "t1": 7.16,
  "set": "front",
  "line": "Something on the other side pulls back,"
 },
 {
  "i": 6,
  "t0": 7.16,
  "t1": 8.34,
  "set": "city",
  "line": "so nobody lets go."
 },
 {
  "i": 7,
  "t0": 8.34,
  "t1": 10.08,
  "set": "city",
  "line": "You get your own knot the day you're born."
 },
 {
  "i": 8,
  "t0": 10.08,
  "t1": 11.4,
  "set": "city",
  "line": "Babies get tiny gloves."
 },
 {
  "i": 9,
  "t0": 11.4,
  "t1": 12.44,
  "set": "city",
  "line": "Weddings are one -handed."
 },
 {
  "i": 10,
  "t0": 12.44,
  "t1": 14.28,
  "set": "city",
  "line": "The ring goes on the hand you're not pulling with."
 },
 {
  "i": 11,
  "t0": 14.28,
  "t1": 16.200000000000003,
  "set": "city",
  "line": "Mail slides along the rope on little hooks."
 },
 {
  "i": 12,
  "t0": 16.200000000000003,
  "t1": 17.380000000000003,
  "set": "coast",
  "line": "A birthday card takes nine years"
 },
 {
  "i": 13,
  "t0": 17.380000000000003,
  "t1": 18.34,
  "set": "city",
  "line": "to reach the other end."
 },
 {
  "i": 14,
  "t0": 18.34,
  "t1": 19.34,
  "set": "city",
  "line": "And sneezing is illegal."
 },
 {
  "i": 15,
  "t0": 19.34,
  "t1": 20.96,
  "set": "city",
  "line": "One guy sneezed in 1971."
 },
 {
  "i": 16,
  "t0": 20.96,
  "t1": 21.94,
  "set": "city",
  "line": "The world lost an inch."
 },
 {
  "i": 17,
  "t0": 21.94,
  "t1": 23.040000000000003,
  "set": "city",
  "line": "Nobody's forgiven him."
 },
 {
  "i": 18,
  "t0": 23.040000000000003,
  "t1": 24.46,
  "set": "front",
  "line": "My family holds the first knot,"
 },
 {
  "i": 19,
  "t0": 24.46,
  "t1": 25.75,
  "set": "front",
  "line": "right where the fog starts."
 },
 {
  "i": 20,
  "t0": 25.75,
  "t1": 27.71,
  "set": "front",
  "line": "Grandma Oona has held it for sixty years."
 },
 {
  "i": 21,
  "t0": 27.71,
  "t1": 28.990000000000002,
  "set": "front",
  "line": "Every night, she hums into the fog."
 },
 {
  "i": 22,
  "t0": 28.990000000000002,
  "t1": 30.150000000000002,
  "set": "front",
  "line": "Sometimes, the fog hums back."
 },
 {
  "i": 23,
  "t0": 30.150000000000002,
  "t1": 30.71,
  "set": "front",
  "line": "She always says,"
 },
 {
  "i": 24,
  "t0": 30.71,
  "t1": 31.790000000000003,
  "set": "front",
  "line": "every rope has two ends,"
 },
 {
  "i": 25,
  "t0": 31.790000000000003,
  "t1": 32.93,
  "set": "front",
  "line": "and both of them are tired."
 },
 {
  "i": 26,
  "t0": 32.93,
  "t1": 34.269999999999996,
  "set": "lawn",
  "line": "At recess, we play tug -of -war."
 },
 {
  "i": 27,
  "t0": 34.269999999999996,
  "t1": 35.19,
  "set": "lawn",
  "line": "I lose on purpose."
 },
 {
  "i": 28,
  "t0": 35.19,
  "t1": 36.93,
  "set": "lawn",
  "line": "I always feel bad for the other team."
 },
 {
  "i": 29,
  "t0": 36.93,
  "t1": 38.169999999999995,
  "set": "city",
  "line": "Once a year on heave day,"
 },
 {
  "i": 30,
  "t0": 38.169999999999995,
  "t1": 39.29,
  "set": "city",
  "line": "the whole world pulls at once,"
 },
 {
  "i": 31,
  "t0": 39.29,
  "t1": 40.349999999999994,
  "set": "city",
  "line": "and we win one step."
 },
 {
  "i": 32,
  "t0": 40.349999999999994,
  "t1": 42.19,
  "set": "lawn",
  "line": "There's one rule they teach you in kindergarten."
 },
 {
  "i": 33,
  "t0": 42.19,
  "t1": 43.97,
  "set": "lawn",
  "line": "The rope only moves when both sides move."
 },
 {
  "i": 34,
  "t0": 43.97,
  "t1": 45.15,
  "set": "lawn",
  "line": "Nobody knows what it means."
 },
 {
  "i": 35,
  "t0": 45.15,
  "t1": 45.849999999999994,
  "set": "front",
  "line": "Then one night,"
 },
 {
  "i": 36,
  "t0": 45.849999999999994,
  "t1": 47.03,
  "set": "front",
  "line": "the rope started to slip."
 },
 {
  "i": 37,
  "t0": 47.03,
  "t1": 47.71,
  "set": "front",
  "line": "One meter,"
 },
 {
  "i": 38,
  "t0": 47.71,
  "t1": 48.44,
  "set": "front",
  "line": "then ten."
 },
 {
  "i": 39,
  "t0": 48.44,
  "t1": 50.08,
  "set": "front",
  "line": "Every night, the fog came closer."
 },
 {
  "i": 40,
  "t0": 50.08,
  "t1": 52.14,
  "set": "front",
  "line": "And every night, it dragged Grandma closer to the edge."
 },
 {
  "i": 41,
  "t0": 52.14,
  "t1": 53.43,
  "set": "city",
  "line": "So the world pulled harder."
 },
 {
  "i": 42,
  "t0": 53.43,
  "t1": 53.93,
  "set": "city",
  "line": "Tractors."
 },
 {
  "i": 43,
  "t0": 53.93,
  "t1": 54.69,
  "set": "city",
  "line": "Elephants."
 },
 {
  "i": 44,
  "t0": 54.69,
  "t1": 55.69,
  "set": "city",
  "line": "Eight billion people,"
 },
 {
  "i": 45,
  "t0": 55.69,
  "t1": 56.25,
  "set": "city",
  "line": "all at once."
 },
 {
  "i": 46,
  "t0": 56.25,
  "t1": 57.05,
  "set": "front",
  "line": "The harder we pulled,"
 },
 {
  "i": 47,
  "t0": 57.05,
  "t1": 57.91,
  "set": "front",
  "line": "the harder they pulled."
 },
 {
  "i": 48,
  "t0": 57.91,
  "t1": 58.83,
  "set": "front",
  "line": "On the seventh night,"
 },
 {
  "i": 49,
  "t0": 58.83,
  "t1": 59.97,
  "set": "front",
  "line": "Grandma's feet were in the fog,"
 },
 {
  "i": 50,
  "t0": 59.97,
  "t1": 61.05,
  "set": "front",
  "line": "and she stopped humming."
 },
 {
  "i": 51,
  "t0": 61.05,
  "t1": 61.949999999999996,
  "set": "front",
  "line": "So I went in,"
 },
 {
  "i": 52,
  "t0": 61.949999999999996,
  "t1": 62.65,
  "set": "front",
  "line": "hand over hand,"
 },
 {
  "i": 53,
  "t0": 62.65,
  "t1": 63.33,
  "set": "front",
  "line": "along the rope."
 },
 {
  "i": 54,
  "t0": 63.33,
  "t1": 64.61,
  "set": "front",
  "line": "I couldn't see my own fingers."
 },
 {
  "i": 55,
  "t0": 64.61,
  "t1": 65.33,
  "set": "front",
  "line": "Then I heard it."
 },
 {
  "i": 56,
  "t0": 65.33,
  "t1": 67.00999999999999,
  "set": "front",
  "line": "Grandma's song, coming from the other side."
 },
 {
  "i": 57,
  "t0": 67.00999999999999,
  "t1": 67.91,
  "set": "ridge",
  "line": "The rope went up a mountain"
 },
 {
  "i": 58,
  "t0": 67.91,
  "t1": 69.00999999999999,
  "set": "ridge",
  "line": "and over a ridge of rock."
 },
 {
  "i": 59,
  "t0": 69.00999999999999,
  "t1": 69.89,
  "set": "ridge",
  "line": "I climbed to the top"
 },
 {
  "i": 60,
  "t0": 69.89,
  "t1": 70.64,
  "set": "ridge",
  "line": "and looked down."
 },
 {
  "i": 61,
  "t0": 70.64,
  "t1": 72.08,
  "set": "ridge",
  "line": "There was another world down there."
 },
 {
  "i": 62,
  "t0": 72.08,
  "t1": 72.72,
  "set": "ridge",
  "line": "Another city."
 },
 {
  "i": 63,
  "t0": 72.72,
  "t1": 74.02,
  "set": "ridge",
  "line": "Another eight billion people,"
 },
 {
  "i": 64,
  "t0": 74.02,
  "t1": 75.08,
  "set": "ridge",
  "line": "holding the same rope."
 },
 {
  "i": 65,
  "t0": 75.08,
  "t1": 76.03999999999999,
  "set": "ridge",
  "line": "And on their first knot,"
 },
 {
  "i": 66,
  "t0": 76.03999999999999,
  "t1": 77.1,
  "set": "ridge",
  "line": "a girl my age."
 },
 {
  "i": 67,
  "t0": 77.1,
  "t1": 78.25999999999999,
  "set": "ridge",
  "line": "Humming Grandma's song."
 },
 {
  "i": 68,
  "t0": 78.25999999999999,
  "t1": 80.56,
  "set": "ridge",
  "line": "Behind her, the whole mountain was sliding toward the sea."
 },
 {
  "i": 69,
  "t0": 80.56,
  "t1": 80.98,
  "set": "ridge",
  "line": "Houses."
 },
 {
  "i": 70,
  "t0": 80.98,
  "t1": 81.38,
  "set": "ridge",
  "line": "Roads."
 },
 {
  "i": 71,
  "t0": 81.38,
  "t1": 81.96,
  "set": "ridge",
  "line": "Everything."
 },
 {
  "i": 72,
  "t0": 81.96,
  "t1": 83.17999999999999,
  "set": "ridge",
  "line": "They weren't pulling against us."
 },
 {
  "i": 73,
  "t0": 83.17999999999999,
  "t1": 84.02,
  "set": "ridge",
  "line": "They were hanging on."
 },
 {
  "i": 74,
  "t0": 84.02,
  "t1": 85.06,
  "set": "front",
  "line": "Every time we pulled,"
 },
 {
  "i": 75,
  "t0": 85.06,
  "t1": 85.66,
  "set": "ridge",
  "line": "they slipped."
 },
 {
  "i": 76,
  "t0": 85.66,
  "t1": 86.58,
  "set": "ridge",
  "line": "Every time they slipped,"
 },
 {
  "i": 77,
  "t0": 86.58,
  "t1": 88.2,
  "set": "front",
  "line": "the rope dragged us into the fog."
 },
 {
  "i": 78,
  "t0": 88.2,
  "t1": 89.24,
  "set": "ridge",
  "line": "We weren't playing tug of war."
 },
 {
  "i": 79,
  "t0": 89.24,
  "t1": 90.28,
  "set": "ridge",
  "line": "We were holding each other up."
 },
 {
  "i": 80,
  "t0": 90.28,
  "t1": 91.88,
  "set": "lawn",
  "line": "I always feel bad for the other team."
 },
 {
  "i": 81,
  "t0": 91.88,
  "t1": 93.2,
  "set": "ridge",
  "line": "This time, the other team was real,"
 },
 {
  "i": 82,
  "t0": 93.2,
  "t1": 94.17999999999999,
  "set": "ridge",
  "line": "so I yelled down to her."
 },
 {
  "i": 83,
  "t0": 94.17999999999999,
  "t1": 95.91,
  "set": "ridge",
  "line": "On three, we both step up!"
 },
 {
  "i": 84,
  "t0": 95.91,
  "t1": 96.31,
  "set": "ridge",
  "line": "One."
 },
 {
  "i": 85,
  "t0": 96.31,
  "t1": 96.63,
  "set": "ridge",
  "line": "Two."
 },
 {
  "i": 86,
  "t0": 96.63,
  "t1": 96.95,
  "set": "ridge",
  "line": "Three."
 },
 {
  "i": 87,
  "t0": 96.95,
  "t1": 97.57,
  "set": "ridge",
  "line": "We stepped."
 },
 {
  "i": 88,
  "t0": 97.57,
  "t1": 98.42999999999999,
  "set": "ridge",
  "line": "The rope didn't slip."
 },
 {
  "i": 89,
  "t0": 98.42999999999999,
  "t1": 98.78999999999999,
  "set": "ridge",
  "line": "It moved."
 },
 {
  "i": 90,
  "t0": 98.78999999999999,
  "t1": 100.35,
  "set": "lawn",
  "line": "The rope only moves when both sides move."
 },
 {
  "i": 91,
  "t0": 100.35,
  "t1": 101.00999999999999,
  "set": "ridge",
  "line": "Step by step,"
 },
 {
  "i": 92,
  "t0": 101.00999999999999,
  "t1": 102.35,
  "set": "ridge",
  "line": "sixteen billion people climbed,"
 },
 {
  "i": 93,
  "t0": 102.35,
  "t1": 103.50999999999999,
  "set": "front",
  "line": "until the fog thinned out and"
 },
 {
  "i": 94,
  "t0": 103.50999999999999,
  "t1": 104.50999999999999,
  "set": "ridge",
  "line": "we could see each other."
 },
 {
  "i": 95,
  "t0": 104.50999999999999,
  "t1": 106.07,
  "set": "ridge",
  "line": "Grandma and the girl's grandma waved."
 },
 {
  "i": 96,
  "t0": 106.07,
  "t1": 107.23,
  "set": "ridge",
  "line": "First time in sixty years."
 },
 {
  "i": 97,
  "t0": 107.23,
  "t1": 108.28999999999999,
  "set": "ridge",
  "line": "Now heave day is wave day."
 },
 {
  "i": 98,
  "t0": 108.28999999999999,
  "t1": 109.64999999999999,
  "set": "ridge",
  "line": "Once a year, both sides take one"
 },
 {
  "i": 99,
  "t0": 109.64999999999999,
  "t1": 110.99,
  "set": "ridge",
  "line": "step up and wave from the ridge."
 },
 {
  "i": 100,
  "t0": 110.99,
  "t1": 111.81,
  "set": "ridge",
  "line": "Nobody lets go."
 },
 {
  "i": 101,
  "t0": 111.81,
  "t1": 113.39,
  "set": "ridge",
  "line": "Now we know who we're holding."
 }
]