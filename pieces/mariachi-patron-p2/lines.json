{
 "i01": [],
 "c01": ["Que nadie salga de la hacienda.", "Ni los invitados, ni tú."],
 "c02": ["Don Rosendo, es un malentendido.", "Ese señor no es nada mío."],
 "r1": [],
 "c03": ["Su mamá se lo llevó chiquito.", "Le cambió el apellido, Rosendo."],
 "c04": ["¿Te daba vergüenza tu padre?", "¿Un mariachi en tu fiesta?"],
 "c05": ["Mis invitados son gente importante.", "No lo iban a entender."],
 "c06": ["Pues que lo entiendan hoy.", "Súbete a esa tarima."],
 "i02": [],
 "c07": ["Señores, escúchenme un momento.", "Este mariachi es mi padre."],
 "r2": [],
 "c08": ["Ahora diles lo que hiciste.", "Que todos lo oigan."],
 "c09": ["Lo corrí sin pagarle.", "Y le tiré su sombrero."],
 "c10": ["Don Rosendo, yo nomás obedecía.", "El patrón me lo ordenó."],
 "c11": ["Deja ese radio en la mesa.", "Ya no trabajas para él."],
 "i03": [],
 "c12": ["Y te vas a pie.", "Hasta el pueblo, caminando."],
 "c13": ["Perdóneme, don Iginio.", "No sabía quién era usted."],
 "c14": ["No importa quién sea uno.", "A nadie se le trata así."],
 "i04": [],
 "r3": [],
 "c15": ["Ahora la cosecha, Gildardo.", "Ya casi amanece."],
 "c16": ["No la tengo completa, don Rosendo.", "Deme un año más."],
 "c17": ["Entonces me llevo tu ganado.", "Hasta la última vaca."],
 "i05": [],
 "r4": [],
 "c18": ["Es todo lo que tengo.", "Me va a dejar sin nada."],
 "c19": ["Así nos dejó usted, tío.", "Sin la renta del mes."],
 "c20": ["Te busqué muchos años, mijo.", "Nunca contestaste una carta."],
 "c21": ["Mi mamá dijo que nos dejó.", "Que no me quería."],
 "c22": ["Ella se fue, mijo.", "Yo me quedé esperándote."],
 "r5": [],
 "c23": ["Yo no sabía nada, apá.", "Y aun así lo corrí."],
 "c24": ["Tú decides, Higinio.", "¿Le devuelvo su ganado?"],
 "c25": ["Devuélvaselo todo, Rosendo.", "Pero con una condición."],
 "c26": ["Un año tocando conmigo.", "En la plaza, por limosna."],
 "c27": ["¿Yo de mariachi, apá?", "¿Delante de toda la gente?"],
 "c28": ["Tu padre tocó seis horas.", "Ahora te toca a ti."],
 "c29": ["Mañana a las ocho, tío.", "Y el estuche lo carga usted."],
 "i06": [],
 "c30": ["Está bien, apá.", "Un año con usted."],
 "i07": [],
 "c31": ["Ya amaneció, compadre.", "Y me debes mis mañanitas."],
 "c32": ["Todavía es tu día, Rosendo.", "Mijo, sácame la guitarra."],
 "i08": [],
 "c33": ["Aquí está, apá.", "Hoy canto con ustedes."],
 "c34": ["¿Ustedes creen que Gildardo merece otra oportunidad?", "Denle me gusta y sigan la página para más historias."]
