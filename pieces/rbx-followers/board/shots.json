[
 {
  "i": 0,
  "t0": 0,
  "t1": 0.52,
  "set": "street",
  "line": "In this town,"
 },
 {
  "i": 1,
  "t0": 0.52,
  "t1": 1.54,
  "set": "street",
  "line": "everyone has followers,"
 },
 {
  "i": 2,
  "t0": 1.54,
  "t1": 3.02,
  "set": "street",
  "line": "and they really do follow you."
 },
 {
  "i": 3,
  "t0": 3.02,
  "t1": 4.36,
  "set": "street",
  "line": "Every follower is a real person,"
 },
 {
  "i": 4,
  "t0": 4.36,
  "t1": 5.4,
  "set": "street",
  "line": "walking right behind you"
 },
 {
  "i": 5,
  "t0": 5.4,
  "t1": 6.140000000000001,
  "set": "street",
  "line": "wherever you go."
 },
 {
  "i": 6,
  "t0": 6.140000000000001,
  "t1": 7.58,
  "set": "street",
  "line": "There's only one way to lose one."
 },
 {
  "i": 7,
  "t0": 7.58,
  "t1": 8.84,
  "set": "street",
  "line": "Turn around and look them in the eye,"
 },
 {
  "i": 8,
  "t0": 8.84,
  "t1": 9.799999999999999,
  "set": "street",
  "line": "and they stop following you."
 },
 {
  "i": 9,
  "t0": 9.799999999999999,
  "t1": 10.219999999999999,
  "set": "street",
  "line": "Forever."
 },
 {
  "i": 10,
  "t0": 10.219999999999999,
  "t1": 12,
  "set": "bridge",
  "line": "That's why famous people never look back."
 },
 {
  "i": 11,
  "t0": 12,
  "t1": 13.78,
  "set": "bridge",
  "line": "A pop star with 90 million followers"
 },
 {
  "i": 12,
  "t0": 13.78,
  "t1": 15.52,
  "set": "bridge",
  "line": "took four years to cross Canada."
 },
 {
  "i": 13,
  "t0": 15.52,
  "t1": 16.68,
  "set": "street",
  "line": "First dates are crowded."
 },
 {
  "i": 14,
  "t0": 16.68,
  "t1": 17.540000000000003,
  "set": "street",
  "line": "You bring everyone."
 },
 {
  "i": 15,
  "t0": 17.540000000000003,
  "t1": 18.48,
  "set": "bridge",
  "line": "And when a cat goes viral,"
 },
 {
  "i": 16,
  "t0": 18.48,
  "t1": 19.28,
  "set": "bridge",
  "line": "the highway closes for month."
 },
 {
  "i": 17,
  "t0": 19.28,
  "t1": 20.98,
  "set": "street",
  "line": "I've had one follower since the day I was born."
 },
 {
  "i": 18,
  "t0": 20.98,
  "t1": 21.52,
  "set": "street",
  "line": "Just one."
 },
 {
  "i": 19,
  "t0": 21.52,
  "t1": 22.66,
  "set": "street",
  "line": "I've never seen who it is."
 },
 {
  "i": 20,
  "t0": 22.66,
  "t1": 23.6,
  "set": "street",
  "line": "I never look back."
 },
 {
  "i": 21,
  "t0": 23.6,
  "t1": 24.580000000000002,
  "set": "street",
  "line": "But I know the sound."
 },
 {
  "i": 22,
  "t0": 24.580000000000002,
  "t1": 25,
  "set": "street",
  "line": "Squeak."
 },
 {
  "i": 23,
  "t0": 25,
  "t1": 25.560000000000002,
  "set": "street",
  "line": "Step."
 },
 {
  "i": 24,
  "t0": 25.560000000000002,
  "t1": 25.92,
  "set": "street",
  "line": "Squeak."
 },
 {
  "i": 25,
  "t0": 25.92,
  "t1": 27.400000000000002,
  "set": "street",
  "line": "One of their shoes always squeaks."
 },
 {
  "i": 26,
  "t0": 27.400000000000002,
  "t1": 28.580000000000002,
  "set": "kitchen",
  "line": "My dad works nights."
 },
 {
  "i": 27,
  "t0": 28.580000000000002,
  "t1": 29.720000000000002,
  "set": "kitchen",
  "line": "He's never home when I'm awake."
 },
 {
  "i": 28,
  "t0": 29.720000000000002,
  "t1": 30.82,
  "set": "kitchen",
  "line": "He leaves me notes on the fridge,"
 },
 {
  "i": 29,
  "t0": 30.82,
  "t1": 32.36,
  "set": "kitchen",
  "line": "and every note ends the same way."
 },
 {
  "i": 30,
  "t0": 32.36,
  "t1": 33.379999999999995,
  "set": "kitchen",
  "line": "Don't look back, kiddo."
 },
 {
  "i": 31,
  "t0": 33.379999999999995,
  "t1": 34.78,
  "set": "kitchen",
  "line": "Whatever's behind you, I've got it."
 },
 {
  "i": 32,
  "t0": 34.78,
  "t1": 35.58,
  "set": "street",
  "line": "Then one day, I"
 },
 {
  "i": 33,
  "t0": 35.58,
  "t1": 37.68,
  "set": "street",
  "line": "slipped and fell into the fountain at the mall."
 },
 {
  "i": 34,
  "t0": 37.68,
  "t1": 38.58,
  "set": "street",
  "line": "Somebody filmed it."
 },
 {
  "i": 35,
  "t0": 38.58,
  "t1": 40.3,
  "set": "street",
  "line": "By lunch, it had three million views."
 },
 {
  "i": 36,
  "t0": 40.3,
  "t1": 41.94,
  "set": "street",
  "line": "The next morning, I opened the front door,"
 },
 {
  "i": 37,
  "t0": 41.94,
  "t1": 43.22,
  "set": "street",
  "line": "and the whole street was full."
 },
 {
  "i": 38,
  "t0": 43.22,
  "t1": 44.46,
  "set": "street",
  "line": "Three million and one people."
 },
 {
  "i": 39,
  "t0": 44.46,
  "t1": 45.36,
  "set": "street",
  "line": "All waiting for me."
 },
 {
  "i": 40,
  "t0": 45.36,
  "t1": 46.22,
  "set": "street",
  "line": "I walked to school."
 },
 {
  "i": 41,
  "t0": 46.22,
  "t1": 47.08,
  "set": "street",
  "line": "They walked to school."
 },
 {
  "i": 42,
  "t0": 47.08,
  "t1": 48.58,
  "set": "classroom",
  "line": "They followed me into math class."
 },
 {
  "i": 43,
  "t0": 48.58,
  "t1": 50.379999999999995,
  "set": "classroom",
  "line": "The teacher gave up and taught all of them."
 },
 {
  "i": 44,
  "t0": 50.379999999999995,
  "t1": 51.78,
  "set": "street",
  "line": "If I stopped, they pushed."
 },
 {
  "i": 45,
  "t0": 51.78,
  "t1": 53.64,
  "set": "street",
  "line": "If I turned left, the whole city turned left."
 },
 {
  "i": 46,
  "t0": 53.64,
  "t1": 54.519999999999996,
  "set": "street",
  "line": "I couldn't even go home."
 },
 {
  "i": 47,
  "t0": 54.519999999999996,
  "t1": 56.12,
  "set": "street",
  "line": "There was no room for my house in the crowd."
 },
 {
  "i": 48,
  "t0": 56.12,
  "t1": 57.04,
  "set": "street",
  "line": "So I tried to lose them."
 },
 {
  "i": 49,
  "t0": 57.04,
  "t1": 58.099999999999994,
  "set": "subway",
  "line": "I jumped on the subway."
 },
 {
  "i": 50,
  "t0": 58.099999999999994,
  "t1": 59.82,
  "set": "subway",
  "line": "Three million people got on behind me."
 },
 {
  "i": 51,
  "t0": 59.82,
  "t1": 60.98,
  "set": "street",
  "line": "I grabbed a megaphone and yelled,"
 },
 {
  "i": 52,
  "t0": 60.98,
  "t1": 61.66,
  "set": "street",
  "line": "unfollow!"
 },
 {
  "i": 53,
  "t0": 61.66,
  "t1": 62.48,
  "set": "street",
  "line": "Nobody left!"
 },
 {
  "i": 54,
  "t0": 62.48,
  "t1": 63.3,
  "set": "bridge",
  "line": "Three days."
 },
 {
  "i": 55,
  "t0": 63.3,
  "t1": 63.919999999999995,
  "set": "bridge",
  "line": "No sleep."
 },
 {
  "i": 56,
  "t0": 63.919999999999995,
  "t1": 64.46,
  "set": "bridge",
  "line": "No home."
 },
 {
  "i": 57,
  "t0": 64.46,
  "t1": 65.5,
  "set": "bridge",
  "line": "And somewhere in all that noise,"
 },
 {
  "i": 58,
  "t0": 65.5,
  "t1": 66.82,
  "set": "bridge",
  "line": "I couldn't hear the squeak anymore."
 },
 {
  "i": 59,
  "t0": 66.82,
  "t1": 68.06,
  "set": "bridge",
  "line": "There was only one way out."
 },
 {
  "i": 60,
  "t0": 68.06,
  "t1": 68.98,
  "set": "bridge",
  "line": "I had to turn around."
 },
 {
  "i": 61,
  "t0": 68.98,
  "t1": 70.74,
  "set": "bridge",
  "line": "But if I turned around, I'd lose all of them."
 },
 {
  "i": 62,
  "t0": 70.74,
  "t1": 72.52,
  "set": "bridge",
  "line": "Even the one who'd been there since day one."
 },
 {
  "i": 63,
  "t0": 72.52,
  "t1": 73.92,
  "set": "bridge",
  "line": "I stopped in the middle of the bridge,"
 },
 {
  "i": 64,
  "t0": 73.92,
  "t1": 76.03999999999999,
  "set": "bridge",
  "line": "with three million strangers breathing down my neck."
 },
 {
  "i": 65,
  "t0": 76.03999999999999,
  "t1": 76.88,
  "set": "bridge",
  "line": "My legs were shaking."
 },
 {
  "i": 66,
  "t0": 76.88,
  "t1": 77.86,
  "set": "bridge",
  "line": "They were chanting my name."
 },
 {
  "i": 67,
  "t0": 77.86,
  "t1": 79.34,
  "set": "bridge",
  "line": "Dad's last note was still in my pocket."
 },
 {
  "i": 68,
  "t0": 79.34,
  "t1": 80.48,
  "set": "bridge",
  "line": "And then, really quiet,"
 },
 {
  "i": 69,
  "t0": 80.48,
  "t1": 81.72,
  "set": "bridge",
  "line": "right behind me, I heard it."
 },
 {
  "i": 70,
  "t0": 81.72,
  "t1": 82.1,
  "set": "bridge",
  "line": "Squeak."
 },
 {
  "i": 71,
  "t0": 82.1,
  "t1": 82.6,
  "set": "bridge",
  "line": "Step."
 },
 {
  "i": 72,
  "t0": 82.6,
  "t1": 83,
  "set": "bridge",
  "line": "Squeak."
 },
 {
  "i": 73,
  "t0": 83,
  "t1": 84.19,
  "set": "bridge",
  "line": "So I turned around."
 },
 {
  "i": 74,
  "t0": 84.19,
  "t1": 85.53,
  "set": "bridge",
  "line": "Three million people blinked,"
 },
 {
  "i": 75,
  "t0": 85.53,
  "t1": 85.97,
  "set": "bridge",
  "line": "shrugged,"
 },
 {
  "i": 76,
  "t0": 85.97,
  "t1": 86.64999999999999,
  "set": "bridge",
  "line": "and walked away."
 },
 {
  "i": 77,
  "t0": 86.64999999999999,
  "t1": 88.27,
  "set": "bridge",
  "line": "The number above my head. Said zero."
 },
 {
  "i": 78,
  "t0": 88.27,
  "t1": 90.67,
  "set": "bridge",
  "line": "And there, three steps back, was a man in a night shift vest."
 },
 {
  "i": 79,
  "t0": 90.67,
  "t1": 91.47,
  "set": "bridge",
  "line": "One old shoe."
 },
 {
  "i": 80,
  "t0": 91.47,
  "t1": 91.89,
  "set": "bridge",
  "line": "Squeaking."
 },
 {
  "i": 81,
  "t0": 91.89,
  "t1": 92.53,
  "set": "bridge",
  "line": "My dad."
 },
 {
  "i": 82,
  "t0": 92.53,
  "t1": 93.37,
  "set": "bridge",
  "line": "He never worked nights."
 },
 {
  "i": 83,
  "t0": 93.37,
  "t1": 95.05,
  "set": "bridge",
  "line": "He told me that, so I'd never look for him."
 },
 {
  "i": 84,
  "t0": 95.05,
  "t1": 97.47,
  "set": "street",
  "line": "For eleven years, he'd walked three steps behind me."
 },
 {
  "i": 85,
  "t0": 97.47,
  "t1": 98.35,
  "set": "street",
  "line": "Every crosswalk."
 },
 {
  "i": 86,
  "t0": 98.35,
  "t1": 99.13,
  "set": "street",
  "line": "Every bad day."
 },
 {
  "i": 87,
  "t0": 99.13,
  "t1": 99.92999999999999,
  "set": "bridge",
  "line": "He wasn't following me."
 },
 {
  "i": 88,
  "t0": 99.92999999999999,
  "t1": 100.75,
  "set": "street",
  "line": "He was walking me home."
 },
 {
  "i": 89,
  "t0": 100.75,
  "t1": 101.35,
  "set": "bridge",
  "line": "He said, you looked."
 },
 {
  "i": 90,
  "t0": 101.35,
  "t1": 102.41,
  "set": "bridge",
  "line": "I said, I wanted to see who it was."
 },
 {
  "i": 91,
  "t0": 102.41,
  "t1": 103.53,
  "set": "street",
  "line": "Now we walk side by side."
 },
 {
  "i": 92,
  "t0": 103.53,
  "t1": 104.33,
  "set": "street",
  "line": "He still squeaks."
 },
 {
  "i": 93,
  "t0": 104.33,
  "t1": 105.50999999999999,
  "set": "street",
  "line": "I still never look back."
 },
 {
  "i": 94,
  "t0": 105.50999999999999,
  "t1": 106.17,
  "set": "street",
  "line": "I don't have to."
 },
 {
  "i": 95,
  "t0": 106.17,
  "t1": 107.09,
  "set": "street",
  "line": "Zero followers."
 },
 {
  "i": 96,
  "t0": 107.09,
  "t1": 108.07,
  "set": "street",
  "line": "Never alone."
 }
]