 "c01": ["Veinte minutos, viejo.", "Y tu caballo pierde."],
 "c02": ["Centella no sabe perder, licenciado.", "Así lo crié yo."],
 "c03": ["Aposté tres millones al mío.", "Hoy no pierdo."],
 "i02": [],
 "c04": ["Tu patrona me debe el rancho.", "Si gana, se lo cobro."],
 "c05": ["Doña Teodora paga lo que debe.", "Pero no vende carreras."],
 "c06": ["Tu nieto monta, ¿verdad?", "Que lo frene en la recta."],
 "c07": ["Yo no me dejo ganar, licenciado.", "Ni por tres millones."],
 "c08": ["Tú cállate, muchacho.", "Aquí hablan los hombres."],
 "c09": ["Don Cleto, ya déjelo así.", "Yo le ensillo a Centella."],
 "c10": ["Y esa cincha nueva, viejo.", "Ojalá le aguante."],
 "r1": [],
 "c11": ["Te quedan diez minutos.", "Tú sabrás."],
 "c12": ["¿Cómo sabe lo de la cincha?", "Nomás tú y yo sabíamos."],
 "c13": ["Se lo diría el herrero.", "Yo no hablo con ese señor."],
 "i03": [],
 "c14": ["Botas nuevas, Jacinto.", "Se ven caras."],
 "c15": ["Me las regaló mi compadre.", "Ya voy a ensillar."],
 "r2": [],
 "c16": ["Abuelo, ya llaman a los jinetes.", "¿Monto o no monto?"],
 "c17": ["Tú monta, mijo.", "Y no frenes por nadie."],
 "i04": [],
 "c18": ["Está cortada a la mitad.", "Corriendo se iba a reventar."],
 "c19": ["¿Quién le hizo esto, abuelo?", "Yo iba arriba."],
 "c20": ["Patrona, ya es hora.", "Es el licenciado Arteaga."],
 "c21": ["Voy para allá, Cleto.", "Que nadie toque a Centella."],
 "i05": [],
 "c22": ["¿Y esas camionetas?", "¿Quién las invitó?"],
 "i06": [],
 "c23": ["Buenas tardes, licenciado.", "Me dicen que le debo."],
 "c24": ["Su rancho, doña Teodora.", "Tengo los papeles firmados."],
 "c25": ["Esos papeles los compré ayer.", "Ahora usted me debe a mí."],
 "c26": ["Eso no puede ser, señora.", "Yo hablé con el banco."],
 "c27": ["Patrona, le cortaron la cincha.", "Fue alguien de aquí adentro."],
 "c28": ["Denme el teléfono de Jacinto.", "Ahorita mismo."],
