 {
  "i": 53,
  "t0": 54.23,
  "t1": 55.589999999999996,
  "set": "hole",
  "line": "One guy made it to the very top,"
 },
 {
  "i": 54,
  "t0": 55.589999999999996,
  "t1": 56.15,
  "set": "hole",
  "line": "waved at us,"
 },
 {
  "i": 55,
  "t0": 56.15,
  "t1": 57.41,
  "set": "hole",
  "line": "slipped, and poofed straight back down."
 },
 {
  "i": 56,
  "t0": 57.41,
  "t1": 58.489999999999995,
  "set": "hole",
  "line": "Turbo kept jumping at the wall."
 },
 {
  "i": 57,
  "t0": 58.489999999999995,
  "t1": 58.989999999999995,
  "set": "hole",
  "line": "Jump."
 },
 {
  "i": 58,
  "t0": 58.989999999999995,
  "t1": 59.309999999999995,
  "set": "hole",
  "line": "Poof."
 },
 {
  "i": 59,
  "t0": 59.309999999999995,
  "t1": 59.65,
  "set": "hole",
  "line": "Jump."
 },
 {
  "i": 60,
  "t0": 59.65,
  "t1": 60.01,
  "set": "hole",
  "line": "Poof."
 },
 {
  "i": 61,
  "t0": 60.01,
  "t1": 61.15,
  "set": "hole",
  "line": "Nobody could go down to help."
