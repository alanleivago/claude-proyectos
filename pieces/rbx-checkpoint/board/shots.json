[
 {
  "i": 0,
  "t0": 0,
  "t1": 0.72,
  "set": "town",
  "line": "In this town,"
 },
 {
  "i": 1,
  "t0": 0.72,
  "t1": 1.2,
  "set": "town",
  "line": "if you fall,"
 },
 {
  "i": 2,
  "t0": 1.2,
  "t1": 2.6,
  "set": "town",
  "line": "you go back to your last checkpoint."
 },
 {
  "i": 3,
  "t0": 2.6,
  "t1": 3.34,
  "set": "town",
  "line": "Touch a flag"
 },
 {
  "i": 4,
  "t0": 3.34,
  "t1": 3.98,
  "set": "town",
  "line": "and it saves you."
 },
 {
  "i": 5,
  "t0": 3.98,
  "t1": 4.800000000000001,
  "set": "town",
  "line": "Trip on the sidewalk,"
 },
 {
  "i": 6,
  "t0": 4.800000000000001,
  "t1": 5.08,
  "set": "town",
  "line": "poof,"
 },
 {
  "i": 7,
  "t0": 5.08,
  "t1": 6.130000000000001,
  "set": "town",
  "line": "you're back at your flag."
 },
 {
  "i": 8,
  "t0": 6.130000000000001,
  "t1": 7.79,
  "set": "house",
  "line": "Rich people keep one by the bed."
 },
 {
  "i": 9,
  "t0": 7.79,
  "t1": 8.51,
  "set": "house",
  "line": "They fall downstairs"
 },
 {
  "i": 10,
  "t0": 8.51,
  "t1": 9.87,
  "set": "house",
  "line": "to get back under the covers."
 },
 {
  "i": 11,
  "t0": 9.87,
  "t1": 11.61,
  "set": "school",
  "line": "The school's checkpoint is in the math room."
 },
 {
  "i": 12,
  "t0": 11.61,
  "t1": 12.27,
  "set": "school",
  "line": "Trip in the hall,"
 },
 {
  "i": 13,
  "t0": 12.27,
  "t1": 13.379999999999999,
  "set": "school",
  "line": "back to fractions."
 },
 {
  "i": 14,
  "t0": 13.379999999999999,
  "t1": 15.059999999999999,
  "set": "pool",
  "line": "Kids save on the water park roof."
 },
 {
  "i": 15,
  "t0": 15.059999999999999,
  "t1": 15.82,
  "set": "pool",
  "line": "Then they jump off."
 },
 {
  "i": 16,
  "t0": 15.82,
  "t1": 16.78,
  "set": "town",
  "line": "The big flag in the square"
 },
 {
  "i": 17,
  "t0": 16.78,
  "t1": 18.1,
  "set": "town",
  "line": "belongs to the Flagman. He says,"
 },
 {
  "i": 18,
  "t0": 18.1,
  "t1": 19.900000000000002,
  "set": "town",
  "line": "\"A flag is only a promise you'll be back.\""
 },
 {
  "i": 19,
  "t0": 19.900000000000002,
  "t1": 20.82,
  "set": "town",
  "line": "Once, at a parade,"
 },
 {
  "i": 20,
  "t0": 20.82,
  "t1": 21.82,
  "set": "town",
  "line": "he carried it off its pole,"
 },
 {
  "i": 21,
  "t0": 21.82,
  "t1": 22.76,
  "set": "town",
  "line": "and everyone who tripped"
 },
 {
  "i": 22,
  "t0": 22.76,
  "t1": 23.94,
  "set": "town",
  "line": "landed behind the tuba."
 },
 {
  "i": 23,
  "t0": 23.94,
  "t1": 25.42,
  "set": "town",
  "line": "I've touched one checkpoint ever."
 },
 {
  "i": 24,
  "t0": 25.42,
  "t1": 26.02,
  "set": "town",
  "line": "I was four."
 },
 {
  "i": 25,
  "t0": 26.02,
  "t1": 27.220000000000002,
  "set": "town",
  "line": "It's on top of the Clock Tower."
 },
 {
  "i": 26,
  "t0": 27.220000000000002,
  "t1": 28.02,
  "set": "town",
  "line": "And I trip a lot."
 },
 {
  "i": 27,
  "t0": 28.02,
  "t1": 28.880000000000003,
  "set": "town",
  "line": "Three hundred steps down,"
 },
 {
  "i": 28,
  "t0": 28.880000000000003,
  "t1": 29.540000000000003,
  "set": "town",
  "line": "every time."
 },
 {
  "i": 29,
  "t0": 29.540000000000003,
  "t1": 30.14,
  "set": "yard",
  "line": "So at recess,"
 },
 {
  "i": 30,
  "t0": 30.14,
  "t1": 31.560000000000002,
  "set": "yard",
  "line": "I'm the floor is lava champion."
 },
 {
  "i": 31,
  "t0": 31.560000000000002,
  "t1": 32.69,
  "set": "yard",
  "line": "I've never touched the floor."
 },
 {
  "i": 32,
  "t0": 32.69,
  "t1": 33.489999999999995,
  "set": "town",
  "line": "My dog Turbo"
 },
 {
  "i": 33,
  "t0": 33.489999999999995,
  "t1": 34.37,
  "set": "town",
  "line": "touches the square flag"
 },
 {
  "i": 34,
  "t0": 34.37,
  "t1": 35.37,
  "set": "town",
  "line": "fifty times a day."
 },
 {
  "i": 35,
  "t0": 35.37,
  "t1": 36.089999999999996,
  "set": "town",
  "line": "He trips on his ears,"
 },
 {
  "i": 36,
  "t0": 36.089999999999996,
  "t1": 36.39,
  "set": "town",
  "line": "poof,"
 },
 {
  "i": 37,
  "t0": 36.39,
  "t1": 37.589999999999996,
  "set": "town",
  "line": "back in the square, wagging."
 },
 {
  "i": 38,
  "t0": 37.589999999999996,
  "t1": 38.47,
  "set": "town",
  "line": "Then came the Fair."
 },
 {
  "i": 39,
  "t0": 38.47,
  "t1": 39.11,
  "set": "town",
  "line": "The ground cracked,"
 },
 {
  "i": 40,
  "t0": 39.11,
  "t1": 40.07,
  "set": "hole",
  "line": "and the square fell in."
 },
 {
  "i": 41,
  "t0": 40.07,
  "t1": 40.87,
  "set": "hole",
  "line": "The pole, the flag,"
 },
 {
  "i": 42,
  "t0": 40.87,
  "t1": 41.769999999999996,
  "set": "hole",
  "line": "the cotton candy stand,"
 },
 {
  "i": 43,
  "t0": 41.769999999999996,
  "t1": 42.33,
  "set": "hole",
  "line": "Turbo."
 },
 {
  "i": 44,
  "t0": 42.33,
  "t1": 44.15,
  "set": "town",
  "line": "Now anyone who tripped anywhere in town"
 },
 {
  "i": 45,
  "t0": 44.15,
  "t1": 45.57,
  "set": "hole",
  "line": "landed at the bottom of a hole."
 },
 {
  "i": 46,
  "t0": 45.57,
  "t1": 47.41,
  "set": "hole",
  "line": "By sunset, half the town was down there."
 },
 {
  "i": 47,
  "t0": 47.41,
  "t1": 49.25,
  "set": "hole",
  "line": "The Flagman too, still holding his whistle."
 },
 {
  "i": 48,
  "t0": 49.25,
  "t1": 50.37,
  "set": "hole",
  "line": "The firemen lowered ladders."
 },
 {
  "i": 49,
  "t0": 50.37,
  "t1": 51.449999999999996,
  "set": "hole",
  "line": "People climbed halfway,"
 },
 {
  "i": 50,
  "t0": 51.449999999999996,
  "t1": 51.79,
  "set": "hole",
  "line": "slipped,"
 },
 {
  "i": 51,
  "t0": 51.79,
  "t1": 53.129999999999995,
  "set": "hole",
  "line": "and poof, back at the bottom."
