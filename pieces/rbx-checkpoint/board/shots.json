 {
  "i": 73,
  "t0": 73.12,
  "t1": 73.8,
  "set": "hole",
  "line": "Floor is lava."
 },
 {
  "i": 74,
  "t0": 73.8,
  "t1": 74.34,
  "set": "hole",
  "line": "Rock to rock,"
 },
 {
  "i": 75,
  "t0": 74.34,
  "t1": 74.88,
  "set": "hole",
  "line": "root to root."
 },
 {
  "i": 76,
  "t0": 74.88,
  "t1": 75.42,
  "set": "hole",
  "line": "At the bottom,"
 },
 {
  "i": 77,
  "t0": 75.42,
  "t1": 77.34,
  "set": "hole",
  "line": "the Flagman held the pole while I untied the cloth."
 },
 {
  "i": 78,
  "t0": 77.34,
  "t1": 78.03999999999999,
  "set": "hole",
  "line": "I put it in my teeth"
 },
 {
  "i": 79,
  "t0": 78.03999999999999,
  "t1": 78.96,
  "set": "hole",
  "line": "and climbed back up."
 },
 {
  "i": 80,
  "t0": 78.96,
  "t1": 80.5,
  "set": "hole",
  "line": "Halfway, a rock broke under my foot."
 },
 {
  "i": 81,
  "t0": 80.5,
  "t1": 81.85,
  "set": "hole",
  "line": "I hung there by one hand."
 },
 {
  "i": 82,
  "t0": 81.85,
  "t1": 82.73,
  "set": "hole",
  "line": "I didn't fall."
 },
 {
  "i": 83,
  "t0": 82.73,
  "t1": 83.75,
  "set": "hole",
  "line": "I never touch the floor."
 },
 {
  "i": 84,
  "t0": 83.75,
  "t1": 85.53,
  "set": "hole",
  "line": "At the top, I stuck the flag in the dirt"
 },
 {
  "i": 85,
  "t0": 85.53,
  "t1": 86.48,
  "set": "hole",
  "line": "and yelled, \"Everybody, trip!\""
 },
 {
  "i": 86,
  "t0": 86.48,
  "t1": 87.78,
  "set": "hole",
  "line": "The Flagman blew his whistle"
 },
 {
  "i": 87,
  "t0": 87.78,
  "t1": 89.98,
  "set": "hole",
  "line": "and shouted, \"A flag is only a promise you'll be back!\""
 },
 {
  "i": 88,
  "t0": 89.98,
  "t1": 91.75999999999999,
  "set": "hole",
  "line": "Two hundred people fell flat on their backs."
 },
 {
  "i": 89,
  "t0": 91.75999999999999,
  "t1": 92.06,
  "set": "hole",
  "line": "Poof."
 },
 {
  "i": 90,
  "t0": 92.06,
  "t1": 92.34,
  "set": "hole",
  "line": "Poof."
 },
 {
  "i": 91,
  "t0": 92.34,
  "t1": 92.66,
  "set": "hole",
  "line": "Poof."
 },
 {
  "i": 92,
  "t0": 92.66,
  "t1": 94.42,
  "set": "hole",
  "line": "The whole town popped up around me."
 },
 {
  "i": 93,
  "t0": 94.42,
  "t1": 95.42,
  "set": "hole",
  "line": "Turbo came up last,"
 },
