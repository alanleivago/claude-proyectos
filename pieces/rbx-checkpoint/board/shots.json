  "line": "Best stick he's ever found."
 },
 {
  "i": 96,
  "t0": 98.02,
  "t1": 100.02,
  "set": "town",
  "line": "Now everyone carries a tiny flag in their pocket."
 },
 {
  "i": 97,
  "t0": 100.02,
  "t1": 102.17999999999999,
  "set": "town",
  "line": "And every morning, Turbo climbs the Clock Tower with me"
 },
 {
  "i": 98,
  "t0": 102.17999999999999,
  "t1": 103.8,
  "set": "town",
  "line": "and touches my flag with his nose."
 },
 {
  "i": 99,
  "t0": 103.8,
  "t1": 104.39999999999999,
  "set": "town",
  "line": "So when he trips,"
 },
 {
  "i": 100,
  "t0": 104.39999999999999,
  "t1": 105.22,
