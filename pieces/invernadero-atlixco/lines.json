{
 "i01": [],
 "c01": ["Hasta que den las seis, Efrén.", "O tu patrona se queda sin cosecha."],
 "c02": ["Esas nochebuenas no son mías.", "Son de doña Hermelinda."],
 "c03": ["Tu patrona ya no decide nada.", "Aquí ahora mando yo."],
 "c04": ["Me crié entre estas plantas.", "No le voy a fallar."],
 "c05": ["Entonces mañana no sale ni un camión.", "Ni uno solo del valle."],
 "c06": ["¿Y quién lo dejó entrar?", "El portón tenía candado."],
 "c07": ["Alguien de la casa me abrió.", "Alguien que sí sabe tratar."],
 "i02": [],
 "c08": ["Señor, váyase por las buenas.", "La patrona no se va a dejar."],
 "c09": ["Usted no se meta, señora.", "Siga regando sus macetas."],
 "r1": [],
 "c10": ["Rufina, métete al invernadero.", "Ya sabes a quién hablarle."],
 "c11": ["Sí, Efrén.", "Ahorita mismo le marco."],
 "c12": ["¿A quién le vas a hablar?", "Que venga, aquí la espero."],
 "c13": ["No la quiera conocer enojada.", "Usted no sabe quién es."],
 "c14": ["¿Qué me va a hacer una señora?", "Si ya ni sale de su casa."],
 "c15": ["Todavía se puede ir, señor.", "Antes que den las seis."],
 "c16": ["Yo de aquí no me muevo.", "Tráeme la pluma, Efrén."],
 "i03": [],
 "c17": ["¿En mi invernadero, Rufina?", "Ahorita voy para allá."],
 "c18": ["Avísenle a los del valle.", "Que saquen todos los camiones."],
 "i04": [],
 "c19": ["Ya van a dar las seis.", "Se te acabó el tiempo."],
 "c20": ["Escuche bien, señor.", "Ya están sonando las campanas."],
 "c21": ["Efrén, ¿oyes los motores?", "Vienen muchos por el camino."],
 "r2": [],
 "i05": [],
 "i06": [],
 "c22": ["¿Quién tiró mi nochebuena?", "Nomás quiero oírlo."],
 "c23": ["Doña Hermelinda, ¿usted aquí?", "Me dijeron que andaba en Puebla."],
 "c24": ["Efrén, ¿estás bien, mijo?", "Perdóname por llegar tarde."],
 "c25": ["Estoy bien, patrona.", "No le firmé nada."],
 "c26": ["Lo sé, Efrén.", "Tú nunca me has fallado."],
 "c27": ["¿Hasta las seis le diste?", "Ya sonaron, Nazario."],
 "c28": ["Ahora el plazo es tuyo.", "Antes que den las siete, te vas del valle."],
 "c29": ["Yo no entré solo, señora.", "Yo traigo un trato firmado."],
 "c30": ["¿Firmado por quién?", "Aquí nadie firma sin mí."],
 "c31": ["Pregúntele a él.", "Viene en mi camioneta."],
 "r3": [],
 "i07": [],
 "r4": [],
 "c32": ["Patrona, ese llavero…", "Es el del patrón Ezequías."],
 "c33": ["¿Ezequías?", "¿Tú le vendiste mi cosecha?"],
 "c34": ["¿Ustedes perdonarían a Ezequías?", "Dale me gusta y sígueme para la segunda parte."]
}
