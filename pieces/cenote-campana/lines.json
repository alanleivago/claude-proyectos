{
 "i01": [],
 "c01": ["Una hora, don Nicasio.", "Y este cenote se cierra."],
 "c02": ["Ese cántaro era de mi madre.", "No tenía por qué romperlo."],
 "c03": ["Aquí ya no entra nadie.", "El terreno es del hotel."],
 "c04": ["La reja no es mía, ingeniero.", "Yo solo cuido la llave."],
 "c05": ["¿Esta llave, viejo?", "Ya no te hace falta."],
 "r1": [],
 "c06": ["¿Quién le dio esa llave?", "Esa llave nunca se presta."],
 "c07": ["La dueña, viejo.", "La que sí firma."],
 "c08": ["Abuelo, hoy vienen los bañistas.", "Ya pagaron su entrada."],
 "c09": ["Que se bañen en el mar.", "Aquí se acabó el negocio."],
 "c10": ["Sí, señora. Ya está cerrado.", "Mañana mismo firma."],
 "r2": [],
 "c11": ["Ingeniero, este cenote tiene dueña.", "Es de doña Zenaida."],
 "c12": ["Esa señora ya no manda.", "Tú cierra la reja, Cosme."],
 "i02": [],
 "c13": ["¿No te quieres ir, viejo?", "Entonces son cien mil."],
 "c14": ["Déjeme tocar la campana.", "Nomás tres veces."],
 "c15": ["¿Una campana? Ándale, toca.", "Nadie te va a oír."],
 "i03": [],
 "c16": ["Abuelo, ¿para qué esa campana?", "¿A quién está llamando?"],
 "c17": ["Esa campana tiene dueña, Citlali.", "Y ella sí la oye."],
 "r3": [],
 "c18": ["Doña Zenaida, la campana del cenote.", "Tocaron tres veces."],
 "c19": ["Tres veces. Es Nicasio.", "Prepárenme las camionetas."],
 "i04": [],
 "c20": ["¿Ya ves? Nadie vino, viejo.", "Te quedan diez minutos."],
 "c21": ["Ingeniero, mire el camino.", "Vienen camionetas blancas."],
 "i05": [],
 "i06": [],
 "c22": ["Ese cántaro lo hizo tu madre.", "¿Quién lo rompió, Nicasio?"],
 "c23": ["Señora, esto ya es del hotel.", "Y él me debe cien mil."],
 "c24": ["Este cenote es mío, ingeniero.", "Desde antes que usted naciera."],
 "c25": ["Esa campana la colgó mi padre.", "Para que Nicasio me llamara."],
 "c26": ["Nunca la había tocado, doña Zenaida.", "Hasta hoy."],
 "c27": ["¿Cien mil le pediste a él?", "Ahora tú se los pagas."],
 "c28": ["Señora, yo solo hago mi trabajo.", "A mí me mandaron."],
 "c29": ["¿Y esa llave, ingeniero?", "Solo mi familia la tiene."],
 "r4": [],
 "c30": ["Doña, le habló una señora.", "Le dijo: mañana mismo firma."],
 "c31": ["Una hora le diste a Nicasio.", "Una hora tienes tú."],
 "c32": ["Citlali, abre la reja, mija.", "Que pasen tus bañistas."],
 "i07": [],
 "c33": ["Patrona, le marcan al ingeniero.", "Es la misma señora."],
 "c34": ["¿Bueno?", "¿Maricruz? ¿Hija, eres tú?"],
 "r5": [],
 "c35": ["¿Qué creen que hará doña Zenaida con su hija?", "Dejen su me gusta y compartan, que viene la segunda parte."]
}
