 "lines": [
  {
   "id": "001-narrator",
   "who": "Narrator",
   "text": "Lunch.",
   "after": 0.85,
   "file": "001-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "002-narrator",
   "who": "Narrator",
   "text": "Nia's elbow hits her juice.",
   "after": 0.85,
   "file": "002-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "003-narrator",
   "who": "Narrator",
   "text": "The carton hasn't even tipped, and your tray is already out of the way.",
   "after": 1.25,
   "file": "003-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "004-nia",
   "who": "Nia",
   "text": "How did you...",
   "after": 0.7,
   "file": "004-nia.wav",
   "take_score": 1.0
  },
  {
   "id": "005-you",
   "who": "You",
   "text": "\"How did you know?\" You were about to say that.",
   "after": 0.7,
   "file": "005-you.wav",
   "take_score": 1.0
  },
  {
   "id": "006-nia",
   "who": "Nia",
   "text": "Okay. That's creepy.",
   "after": 0.7,
   "file": "006-nia.wav",
   "take_score": 1.0
  },
  {
   "id": "007-narrator",
   "who": "Narrator",
   "text": "Your brain lives in the past.",
   "after": 0.85,
   "file": "007-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "008-narrator",
   "who": "Narrator",
   "text": "Everything you see is at least eighty milliseconds old.",
   "after": 0.85,
   "file": "008-narrator.wav",
   "take_score": 0.889
  },
  {
   "id": "009-narrator",
   "who": "Narrator",
   "text": "Yours runs the other way.",
   "after": 0.85,
   "file": "009-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "010-narrator",
   "who": "Narrator",
   "text": "You see ten whole seconds ahead.",
   "after": 1.25,
   "file": "010-narrator.wav",
   "take_score": 0.833
  },
  {
   "id": "011-narrator",
   "who": "Narrator",
   "text": "So, what if you could see ten seconds into the future?",
   "after": 4.25,
   "beat": 2.0,
   "file": "011-narrator.wav",
   "take_score": 0.909
  },
  {
   "id": "012-narrator",
   "who": "Narrator",
   "text": "Here's how it works.",
   "after": 0.85,
   "file": "012-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "013-narrator",
   "who": "Narrator",
   "text": "On top of the real world, you see a pale ghost of it, ten seconds ahead.",
   "after": 0.85,
   "file": "013-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "014-narrator",
   "who": "Narrator",
   "text": "Only what your own eyes would see.",
   "after": 0.85,
   "file": "014-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "015-narrator",
   "who": "Narrator",
   "text": "And only the future where you do nothing.",
   "after": 0.85,
   "file": "015-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "016-narrator",
   "who": "Narrator",
   "text": "Move, and the ghost moves with you.",
   "after": 3.25,
   "beat": 1.0,
   "file": "016-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "017-narrator",
   "who": "Narrator",
   "text": "Plus.",
   "after": 0.85,
   "file": "017-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "018-narrator",
   "who": "Narrator",
   "text": "The small stuff.",
   "after": 1.25,
   "file": "018-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "019-nia",
   "who": "Nia",
   "text": "Your phone!",
   "after": 0.7,
   "file": "019-nia.wav",
   "take_score": 1.0
  },
  {
   "id": "020-you",
   "who": "You",
   "text": "Got it.",
   "after": 0.7,
   "file": "020-you.wav",
   "take_score": 1.0
  },
  {
   "id": "021-coach",
   "who": "Coach",
   "text": "Heads up!",
   "after": 0.7,
   "file": "021-coach.wav",
   "take_score": 1.0
  },
  {
   "id": "022-you",
   "who": "You",
   "text": "Already up.",
   "after": 0.7,
   "file": "022-you.wav",
   "take_score": 1.0
  },
  {
   "id": "023-narrator",
   "who": "Narrator",
   "text": "Pop quiz.",
   "after": 0.85,
   "file": "023-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "024-narrator",
   "who": "Narrator",
   "text": "You know who gets picked, and you know the answer.",
   "after": 1.25,
   "file": "024-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "025-teacher",
   "who": "Teacher",
   "text": "Theo?",
   "after": 0.7,
   "file": "025-teacher.wav",
   "take_score": 1.0
  },
  {
   "id": "026-you",
   "who": "You",
   "text": "Photosynthesis.",
   "after": 0.7,
   "file": "026-you.wav",
   "take_score": 1.0
  },
  {
   "id": "027-teacher",
   "who": "Teacher",
   "text": "I haven't asked yet.",
   "after": 0.7,
   "file": "027-teacher.wav",
   "take_score": 1.0
  },
  {
   "id": "028-narrator",
   "who": "Narrator",
   "text": "Rock, paper, scissors with Nia.",
   "after": 0.85,
   "file": "028-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "029-narrator",
   "who": "Narrator",
   "text": "Fifty rounds.",
   "after": 0.85,
   "file": "029-narrator.wav",
   "take_score": 0.5
  },
  {
   "id": "030-narrator",
   "who": "Narrator",
   "text": "Fifty wins.",
   "after": 1.25,
   "file": "030-narrator.wav",
   "take_score": 0.5
  },
  {
   "id": "031-nia",
   "who": "Nia",
   "text": "Spoiler.",
   "after": 0.7,
   "file": "031-nia.wav",
   "take_score": 1.0
  },
  {
   "id": "032-narrator",
   "who": "Narrator",
   "text": "That's her word for you now.",
   "after": 1.25,
   "file": "032-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "033-narrator",
   "who": "Narrator",
   "text": "The claw machine at the arcade.",
   "after": 0.85,
   "file": "033-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "034-narrator",
   "who": "Narrator",
   "text": "You just wait for the ghost to grab.",
   "after": 1.25,
   "file": "034-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "035-manager",
   "who": "Manager",
   "text": "Kid, that machine is rigged.",
   "after": 0.7,
   "file": "035-manager.wav",
   "take_score": 1.0
  },
  {
   "id": "036-you",
   "who": "You",
   "text": "I know. Watch.",
   "after": 3.7,
   "beat": 2.0,
   "file": "036-you.wav",
   "take_score": 1.0
  },
  {
   "id": "037-narrator",
   "who": "Narrator",
   "text": "Eleven plushies.",
   "after": 1.25,
   "file": "037-narrator.wav",
   "take_score": 0.5
  },
  {
   "id": "038-manager",
   "who": "Manager",
   "text": "Okay. Out.",
   "after": 0.7,
   "file": "038-manager.wav",
   "take_score": 1.0
  },
  {
   "id": "039-narrator",
   "who": "Narrator",
   "text": "Wall Street once spent about three hundred million dollars on a cable, just to be three milliseconds faster than everyone else.",
   "after": 0.85,
   "file": "039-narrator.wav",
   "take_score": 0.85
  },
  {
   "id": "040-narrator",
   "who": "Narrator",
   "text": "You're ten thousand milliseconds faster.",
   "after": 1.25,
   "file": "040-narrator.wav",
   "take_score": 0.667
  },
  {
   "id": "041-nia",
   "who": "Nia",
   "text": "You could rob Wall Street.",
   "after": 0.7,
   "file": "041-nia.wav",
   "take_score": 1.0
  },
  {
   "id": "042-you",
   "who": "You",
   "text": "I have fourteen dollars.",
   "after": 2.7,
   "beat": 1.0,
   "file": "042-you.wav",
   "take_score": 0.571
  },
  {
   "id": "043-narrator",
   "who": "Narrator",
   "text": "Minus.",
   "after": 0.85,
   "file": "043-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "044-narrator",
   "who": "Narrator",
   "text": "Nothing surprises you.",
   "after": 0.85,
   "file": "044-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "045-narrator",
   "who": "Narrator",
   "text": "You hear \"Surprise!\" ten seconds before anyone yells it.",
   "after": 1.25,
   "file": "045-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "047-nia",
   "who": "Nia",
   "text": "At least act surprised.",
   "after": 0.7,
   "file": "047-nia.wav",
   "take_score": 1.0
  },
  {
   "id": "048-you",
   "who": "You",
   "text": "Wow. A party.",
   "after": 0.7,
   "file": "048-you.wav",
   "take_score": 1.0
  },
  {
   "id": "049-narrator",
   "who": "Narrator",
   "text": "You laugh before the punchline.",
   "after": 0.85,
   "file": "049-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "050-narrator",
   "who": "Narrator",
   "text": "You answer before the question.",
   "after": 1.25,
   "file": "050-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "051-nia",
   "who": "Nia",
   "text": "Let me finish one sentence. One. Please.",
   "after": 0.7,
   "file": "051-nia.wav",
   "take_score": 1.0
  },
  {
   "id": "052-narrator",
   "who": "Narrator",
   "text": "Everyone else lives right now.",
   "after": 0.85,
   "file": "052-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "053-narrator",
   "who": "Narrator",
   "text": "You live ten seconds away from all of them.",
   "after": 1.25,
   "file": "053-narrator.wav",
   "take_score": 0.889
  },
  {
   "id": "054-narrator",
   "who": "Narrator",
   "text": "And you see every accident before it happens.",
   "after": 0.85,
   "file": "054-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "055-narrator",
   "who": "Narrator",
   "text": "A ball rolling into the street.",
   "after": 0.85,
   "file": "055-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "056-narrator",
   "who": "Narrator",
   "text": "A cyclist about to hit a car door.",
   "after": 0.85,
   "file": "056-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "057-narrator",
   "who": "Narrator",
   "text": "A ladder about to tip.",
   "after": 0.85,
   "file": "057-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "058-narrator",
   "who": "Narrator",
   "text": "So you quietly fix them.",
   "after": 1.25,
   "file": "058-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "059-painter",
   "who": "Painter",
   "text": "Hey! What are you doing?",
   "after": 0.7,
   "file": "059-painter.wav",
   "take_score": 1.0
  },
  {
   "id": "060-you",
   "who": "You",
   "text": "Sorry. Thought it was falling.",
   "after": 0.7,
   "file": "060-you.wav",
   "take_score": 1.0
  },
  {
   "id": "061-narrator",
   "who": "Narrator",
   "text": "It was.",
   "after": 1.25,
   "file": "061-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "062-narrator",
   "who": "Narrator",
   "text": "Futures changed: one hundred and twelve.",
   "after": 0.85,
   "file": "062-narrator.wav",
   "take_score": 0.444
  },
  {
   "id": "063-narrator",
   "who": "Narrator",
   "text": "Thank-yous: zero.",
   "after": 1.25,
   "file": "063-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "064-narrator",
   "who": "Narrator",
   "text": "When you stop a disaster, nobody ever sees the disaster.",
   "after": 4.25,
   "beat": 2.0,
   "file": "064-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "065-narrator",
   "who": "Narrator",
   "text": "Then there's Dad.",
   "after": 0.85,
   "file": "065-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "066-narrator",
   "who": "Narrator",
   "text": "He drives the night bus.",
   "after": 1.25,
   "file": "066-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "067-dad",
   "who": "Dad",
   "text": "Twenty-two years, not one scratch. Know why?",
   "after": 0.7,
   "file": "067-dad.wav",
   "take_score": 0.8
  },
  {
   "id": "068-you",
   "who": "You",
   "text": "Eyes on the road.",
   "after": 0.7,
   "file": "068-you.wav",
   "take_score": 1.0
  },
  {
   "id": "069-dad",
   "who": "Dad",
   "text": "Eyes on the road, kid.",
   "after": 0.7,
   "file": "069-dad.wav",
   "take_score": 1.0
  },
  {
   "id": "070-narrator",
   "who": "Narrator",
   "text": "One Friday, you ride with him.",
   "after": 0.85,
   "file": "070-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "071-narrator",
   "who": "Narrator",
   "text": "Rain.",
