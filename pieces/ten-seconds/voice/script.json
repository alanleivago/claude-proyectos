   "id": "094-narrator",
   "who": "Narrator",
   "text": "Smooth voice.",
   "after": 1.25,
   "file": "094-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "095-voss",
   "who": "Voss",
   "text": "We pulled the camera. A truck goes by. No crash. A driver slams the brakes for nothing, and a passenger breaks her wrist.",
   "after": 0.7,
   "file": "095-voss.wav",
   "take_score": 1.0
  },
  {
   "id": "096-dad",
   "who": "Dad",
   "text": "I saw something.",
   "after": 0.7,
   "file": "096-dad.wav",
   "take_score": 1.0
  },
  {
   "id": "097-voss",
   "who": "Voss",
   "text": "What did you see, Raymond?",
   "after": 0.7,
   "file": "097-voss.wav",
   "take_score": 1.0
  },
  {
   "id": "098-narrator",
   "who": "Narrator",
   "text": "Dad looks at you.",
