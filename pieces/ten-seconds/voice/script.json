   "file": "098-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "099-narrator",
   "who": "Narrator",
   "text": "And says nothing.",
   "after": 1.25,
   "file": "099-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "100-voss",
   "who": "Voss",
   "text": "Suspended. Pending review.",
   "after": 3.7,
   "beat": 2.0,
   "file": "100-voss.wav",
   "take_score": 1.0
  },
  {
   "id": "101-narrator",
   "who": "Narrator",
   "text": "Twenty-two years, gone in ten seconds only you saw.",
   "after": 1.25,
   "file": "101-narrator.wav",
   "take_score": 0.737
  },
  {
   "id": "102-narrator",
