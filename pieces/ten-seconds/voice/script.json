   "file": "071-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "072-narrator",
   "who": "Narrator",
   "text": "Line nine.",
   "after": 1.25,
   "file": "072-narrator.wav",
   "take_score": 0.5
  },
  {
   "id": "073-dad",
   "who": "Dad",
   "text": "Rain like this, nobody's out.",
   "after": 0.7,
   "file": "073-dad.wav",
   "take_score": 1.0
  },
  {
   "id": "074-narrator",
   "who": "Narrator",
   "text": "At Fifth and Main, the light turns yellow.",
   "after": 0.85,
   "file": "074-narrator.wav",
   "take_score": 0.875
  },
  {
   "id": "075-narrator",
   "who": "Narrator",
   "text": "Then red.",
   "after": 0.85,
   "file": "075-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "076-narrator",
   "who": "Narrator",
   "text": "And in the ghost, ten seconds ahead, a truck comes through that red light, straight into the side of the bus.",
   "after": 3.25,
   "beat": 1.0,
   "file": "076-narrator.wav",
   "take_score": 0.952
  },
  {
   "id": "077-narrator",
   "who": "Narrator",
   "text": "Ten seconds.",
   "after": 0.85,
   "file": "077-narrator.wav",
   "take_score": 0.5
  },
  {
   "id": "078-narrator",
   "who": "Narrator",
   "text": "Not enough time to explain.",
   "after": 1.25,
   "file": "078-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "079-you",
   "who": "You",
   "text": "Dad. Brake. Now.",
   "after": 0.7,
   "file": "079-you.wav",
   "take_score": 0.667
  },
  {
   "id": "080-narrator",
   "who": "Narrator",
   "text": "He doesn't ask why.",
   "after": 0.85,
   "file": "080-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "081-narrator",
   "who": "Narrator",
   "text": "He brakes.",
   "after": 4.25,
   "beat": 2.0,
   "file": "081-narrator.wav",
   "take_score": 0.5
  },
  {
   "id": "082-narrator",
   "who": "Narrator",
   "text": "The truck roars past the windshield.",
   "after": 0.85,
   "file": "082-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "083-narrator",
   "who": "Narrator",
   "text": "Close enough to read the logo.",
   "after": 1.25,
   "file": "083-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "084-narrator",
   "who": "Narrator",
   "text": "Inside, everything flies.",
   "after": 0.85,
   "file": "084-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "085-narrator",
   "who": "Narrator",
   "text": "Shopping bags.",
   "after": 0.85,
   "file": "085-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "086-narrator",
   "who": "Narrator",
   "text": "A cane.",
   "after": 0.85,
   "file": "086-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "087-narrator",
   "who": "Narrator",
   "text": "And Mrs. Okafor, seat four, hits the floor.",
   "after": 1.25,
   "file": "087-narrator.wav",
   "take_score": 1.0
  },
  {
   "id": "089-mrsokafor",
   "who": "Mrs. Okafor",
   "text": "My wrist...",
   "after": 3.7,
   "beat": 2.0,
   "file": "089-mrsokafor.wav",
   "take_score": 1.0
  },
  {
   "id": "090-narrator",
   "who": "Narrator",
   "text": "Monday.",
   "after": 0.85,
   "file": "090-narrator.wav",
   "take_score": 1.0
  },
