{
 "i01": [],
 "c01": ["Diez minutos, Lencho.", "O aparece ese maletín."],
 "c02": ["Yo no toqué ese maletín, joven.", "Se lo juro por mi hijo."],
 "c03": ["Anoche lo dejé en la cajuela.", "Y hoy ya no está."],
 "i02": [],
 "c04": ["Tú manejaste esta camioneta.", "Tú tienes la llave."],
 "c05": ["La cajuela tiene dos llaves, joven.", "Una es mía."],
 "c06": ["Y la otra es mía.", "¿Me estás acusando, chofer?"],
 "r1": [],
 "c07": ["Apá, levántese, por favor.", "Usted no hizo nada."],
 "c08": ["Tú cállate, muchacho.", "Hoy se van los dos."],
 "c09": ["Joven, Lencho lleva veinte años aquí.", "La patrona confía en él."],
 "c10": ["La patrona no está.", "Aquí mando yo."],
 "c11": ["Joven, le habla otra vez", "el licenciado Treviño."],
 "c12": ["Ahorita no, Brígido.", "Primero lo de este viejo."],
 "c13": ["Que revisen la cámara, joven.", "La de la camioneta."],
 "c14": ["Esa cámara no graba.", "Ya la revisé anoche."],
 "r2": [],
 "c15": ["Yo la cambié el martes.", "Sí graba, joven."],
 "c16": ["Te quedan cinco minutos.", "Y luego te saco yo."],
 "r3": [],
 "c17": ["Tranquilo, mijo. Aquí me quedo.", "El que nada debe, nada teme."],
 "c18": ["¿Cómo que Lencho está de rodillas?", "Ya vamos para allá."],
 "i03": [],
 "c19": ["Joven, la patrona viene llegando.", "Ya entró al portón."],
 "c20": ["¿Mi madre? ¿Tan temprano?", "¿Quién le avisó?"],
 "i04": [],
 "i05": [],
 "c21": ["Párate, Lencho.", "Tú no te hincas ante nadie."],
 "c22": ["Madre, se llevó el maletín.", "Era medio millón."],
 "c23": ["Veinte años me ha manejado.", "Nunca me faltó un peso."],
 "c24": ["Patrona, que revisen la cámara.", "Nomás eso le pido."],
 "c25": ["Brígido, tráeme esa grabación.", "Ahorita mismo."],
 "c26": ["Madre, esa cámara no sirve.", "No pierda su tiempo."],
 "c27": ["¿Y tú cómo sabes, mijo?", "¿Ya la viste?"],
 "r4": [],
 "i06": [],
 "c28": ["Anoche, a las tres, patrona.", "Abrió con su propia llave."],
 "c29": ["¿Fuiste tú, Valente?", "¿Y dejaste que culparan a Lencho?"],
 "c30": ["Se lo iba a regresar, madre.", "Era un préstamo nomás."],
 "c31": ["Tienes hasta mañana, Valente.", "O no vuelves a esta casa."],
 "c32": ["Perdóname, Lencho.", "Aquí nadie te vuelve a humillar."],
 "i07": [],
 "c33": ["Patrona, mire quién lo recibió.", "Esa troca blanca es de Treviño."],
 "c34": ["¿De Treviño?", "¿El que se llevó a tu padre?"],
 "r5": [],
 "c35": ["¿Ustedes creen que la patrona debe perdonar a Valente?", "Denle me gusta y compartan para ver la segunda parte."]
